---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import { t } from '@i18n/utils';
import Lettering from '@components/designs/cartoon/Lettering';
---

<BaseLayout title="404 — Alexandre Akira">
  <Header />
  <main id="main-content" class="flex min-h-screen items-center justify-center px-6">
    <div class="text-center">
      <p class="font-heading text-[clamp(6rem,20vw,12rem)] font-bold leading-none text-accent-display" data-design-hide="cartoon">
        404
      </p>
      {/* Cartoon: the iris has closed on an empty frame */}
      <p class="cartoon-404" data-design-show="cartoon" aria-hidden="true">
        <Lettering text="404" />
      </p>
      <h1 class="mt-4 font-heading text-2xl font-bold text-text md:text-3xl">
        <span data-lang-show="en">{t('404.title', 'en')}</span>
        <span data-lang-show="pt">{t('404.title', 'pt')}</span>
      </h1>
      <p class="mt-3 max-w-md text-text-secondary">
        <span data-lang-show="en">{t('404.description', 'en')}</span>
        <span data-lang-show="pt">{t('404.description', 'pt')}</span>
      </p>
      <a href="/" class="cartoon-ticket mt-8" data-design-show="cartoon">
        <span data-lang-show="en">{t('404.back', 'en')}</span>
        <span data-lang-show="pt">{t('404.back', 'pt')}</span>
      </a>
      <a
        href="/"
        class="mt-8 inline-block rounded-btn border border-accent px-6 py-3 text-sm font-medium text-accent transition-colors hover:bg-accent/10"
        data-design-hide="cartoon"
      >
        <span data-lang-show="en">{t('404.back', 'en')}</span>
        <span data-lang-show="pt">{t('404.back', 'pt')}</span>
      </a>
      <a
        href="/blog/"
        class="mt-8 ml-4 inline-block px-2 py-3 text-sm font-medium text-text underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-accent"
      >
        <span data-lang-show="en">{t('nav.blog', 'en')}</span>
        <span data-lang-show="pt">{t('nav.blog', 'pt')}</span>
      </a>
    </div>
  </main>
</BaseLayout>
