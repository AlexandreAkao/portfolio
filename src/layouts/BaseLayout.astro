---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import AvantgardeCursor from '@components/designs/avantgarde/AvantgardeCursor.tsx';
import SiteIntro from '@components/common/SiteIntro.astro';
import T from '@components/ui/T.astro';
import { designIds, defaultDesign } from '@data/designs';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  locale?: 'en' | 'pt';
  /** Paths of this page in each language, when both exist. Drives hreflang and the language switch. */
  alternates?: { en: string; pt: string };
  /** The page is written in one language (a post): its chrome follows it instead of the visitor's preference. */
  localeFixed?: boolean;
}

const {
  title,
  description = 'Alexandre Akira - Senior Full-Stack Engineer',
  image,
  type = 'website',
  publishedTime,
  tags,
  locale,
  alternates,
  localeFixed = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site!.origin;
const ogImage = image ? new URL(image, siteUrl).href : `${siteUrl}/images/avatar.jpeg`;

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      datePublished: publishedTime,
      author: {
        '@type': 'Person',
        name: 'Alexandre Akira',
        url: siteUrl,
      },
      publisher: {
        '@type': 'Person',
        name: 'Alexandre Akira',
        url: siteUrl,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl.href,
      },
      ...(tags?.length ? { keywords: tags.join(', ') } : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Alexandre Akira',
      url: siteUrl,
      jobTitle: 'Senior Full-Stack Engineer',
      image: `${siteUrl}/images/avatar.jpeg`,
      sameAs: [
        'https://github.com/alexandreakao',
        'https://www.linkedin.com/in/alexandre-akao/',
        'https://dev.to/alexandreakira',
      ],
    };
---

<html lang={locale || 'en'} data-design={defaultDesign} data-lang={locale || 'en'} data-lang-fixed={localeFixed || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Alexandre Akira" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Alexandre Akira" />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- hreflang: only pages that exist in both languages declare alternates -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site).href} />
        <link rel="alternate" hreflang="pt-BR" href={new URL(alternates.pt, Astro.site).href} />
      </>
    )}

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@200,300,400,500,600,700&display=swap" />
    <ClientRouter />
    <!-- Without JavaScript, Motion's server-rendered start states (opacity 0, offset) would hide the page -->
    <noscript>
      <style>
        [style*='opacity:0'],
        [style*='opacity: 0'],
        [style*='scaleX(0)'] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      import '@/lib/reduced-motion';
    </script>
    <script is:inline define:vars={{ validDesigns: designIds, fallbackDesign: defaultDesign }}>
      (function() {
        try {
          var d = localStorage.getItem('design') || fallbackDesign;
          if (validDesigns.indexOf(d) === -1) d = fallbackDesign;
          document.documentElement.dataset.design = d;

          // An explicit ?lang= or the /pt/ address wins over the stored preference.
          var params = new URLSearchParams(window.location.search);
          var langParam = params.get('lang');
          var pathLang = /^\/pt(\/|$)/.test(window.location.pathname) ? 'pt' : null;
          var fixed = document.documentElement.hasAttribute('data-lang-fixed');
          var lang = fixed ? document.documentElement.dataset.lang : langParam || pathLang || localStorage.getItem('lang') || 'en';
          if (lang !== 'en' && lang !== 'pt') lang = 'en';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          if (!fixed) localStorage.setItem('lang', lang);

          // Arm the intro curtain before first paint, on the home's first hard load
          // of the session only; reduced-motion visitors and deep links skip it.
          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var onHome = /^\/(pt\/?)?$/.test(window.location.pathname);
          if (!reduce && onHome && !sessionStorage.getItem('intro-seen')) {
            document.documentElement.dataset.intro = 'wait';
            sessionStorage.setItem('intro-seen', '1');
          }
        } catch(e) {}
      })();
      document.addEventListener('astro:after-swap', function() {
        try {
          var d = localStorage.getItem('design') || fallbackDesign;
          if (validDesigns.indexOf(d) === -1) d = fallbackDesign;
          document.documentElement.dataset.design = d;
          var pathLang = /^\/pt(\/|$)/.test(window.location.pathname) ? 'pt' : null;
          var fixed = document.documentElement.hasAttribute('data-lang-fixed');
          var lang = fixed ? document.documentElement.dataset.lang : pathLang || localStorage.getItem('lang') || 'en';
          if (lang !== 'en' && lang !== 'pt') lang = 'en';
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          if (!fixed) localStorage.setItem('lang', lang);
        } catch(e) {}
      });
    </script>
  </head>
  <body class="min-h-screen">
    <SiteIntro />
    <a
      href="#main-content"
      class="fixed left-4 top-4 z-100 -translate-y-20 rounded-btn bg-accent px-4 py-3 text-sm font-medium text-on-accent transition-transform focus:translate-y-0"
    >
      <T k="a11y.skip" />
    </a>
    <slot />
    <AvantgardeCursor client:load transition:persist />
  </body>
</html>
