---
import { projects } from '@data/projects';
import T from '@components/ui/T.astro';
import RfcHeading from './RfcHeading.astro';

// Professional work is told in section 2 (the hero's "View my work" leads there); this section keeps the personal repositories.
const personal = projects.filter((p) => p.type === 'personal');
---
<div class="rfc-col">
  <RfcHeading n="5." k="projects.title" />
  <h3 class="rfc-h"><span class="rfc-n">5.1.</span><T k="projects.personal" /></h3>
  <dl class="rfc-refs">
    {personal.map((p) => (
      <>
        <dt><a href={p.github ?? p.live} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} on GitHub`}>{p.title}</a></dt>
        <dd>
          <span data-lang-show="en">{p.description.en}</span><span data-lang-show="pt">{p.description.pt}</span>
          <br /><span class="rfc-muted">{p.tech.join(', ')}</span>
        </dd>
      </>
    ))}
  </dl>
</div>
