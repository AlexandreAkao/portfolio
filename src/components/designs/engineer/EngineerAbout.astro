---
import { t } from '@i18n/utils';
import T from '@components/ui/T.astro';
import Figures from '@components/ui/Figures.astro';
import RfcHeading from './RfcHeading.astro';

const stats = [
  { valueKey: 'about.stat.years', labelKey: 'about.stat.years.label' },
  { valueKey: 'about.stat.centers', labelKey: 'about.stat.centers.label' },
  { valueKey: 'about.stat.components', labelKey: 'about.stat.components.label' },
  { valueKey: 'about.stat.microservices', labelKey: 'about.stat.microservices.label' },
];
---
<div class="rfc-col">
  <RfcHeading n="1." k="rfc.intro" />
  {(['about.p1', 'about.p2'] as const).map((k) => (
    <p class="rfc-ind">
      <span data-lang-show="en"><Figures text={t(k, 'en')} markClass="rfc-mark" /></span>
      <span data-lang-show="pt"><Figures text={t(k, 'pt')} markClass="rfc-mark" /></span>
    </p>
  ))}
  <h3 class="rfc-h"><span class="rfc-n">1.1.</span><T k="about.numbers" /></h3>
  <table class="rfc-table">
    <thead>
      <tr><th scope="col"><T k="rfc.item" /></th><th scope="col"><T k="rfc.value" /></th></tr>
    </thead>
    <tbody>
      {stats.map((s) => (
        <tr><td><T k={s.labelKey} /></td><td><T k={s.valueKey} /></td></tr>
      ))}
    </tbody>
  </table>
  <p class="rfc-cap"><T k="rfc.table" /> 1</p>
</div>
