---
import { experiences } from '@data/experience';
import T from '@components/ui/T.astro';
import { Band, Cross, Flag } from './marks';

/**
 * The career punched as two tracks of tape over the years: roles that ran at
 * the same time sit on separate tracks, so concurrency reads honestly.
 * Periods are parsed from the English data; a year without a month starts in
 * January (so "2022 - 2023" spans 2022).
 */
const months: Record<string, number> = { Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5, Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11 };
const now = new Date();
const parse = (s: string) => {
  const m = s.trim().match(/^(?:([A-Z][a-z]{2}) )?(\d{4})$/);
  if (!m) return now;
  return new Date(Number(m[2]), m[1] ? months[m[1]] : 0, 1);
};
const leaves = experiences.flatMap((e) => (e.subEntries ? e.subEntries : [e]));
const roles = leaves
  .map((e) => {
    const [a, b] = e.period.en.split(' - ');
    return { e, start: parse(a), end: b === 'Present' ? now : parse(b), active: b === 'Present' };
  })
  .sort((x, y) => +x.start - +y.start);
const first = new Date(roles[0].start.getFullYear(), roles[0].start.getMonth(), 1);
const span = +now - +first;
const pct = (d: Date) => ((+d - +first) / span) * 100;
const trackEnds: number[] = [];
const bars = roles.map((r) => {
  let track = trackEnds.findIndex((end) => end <= +r.start);
  if (track === -1) track = trackEnds.push(0) - 1;
  trackEnds[track] = +r.end;
  return { ...r, track, left: pct(r.start), width: pct(r.end) - pct(r.start) };
});
const years: number[] = [];
for (let y = first.getFullYear() + 1; y <= now.getFullYear(); y++) years.push(y);
// Sub-roles go by their own name; on wide screens a bar too short for its name keeps only its mark (the name is in its title and in the windows below)
const label = (b: { e: { company: string }; width: number }) =>
  (b.width >= 25 ? b.e.company.replace(' - ', ' · ') : b.e.company.replace('AmbevTech - ', '')).toUpperCase();
const narrow = (b: { width: number }) => b.width < 8;
---
<div class="tape-career tape-caps" role="img" aria-labelledby="tape-career-label">
  <span id="tape-career-label" class="sr-only"><T k="tape.career" /></span>
  <div class="tape-career__band"></div>
  {bars.map((b) => (
    <span
      class="tape-career__bar"
      data-track={b.track}
      data-active={b.active || undefined}
      data-narrow={narrow(b) || undefined}
      style={`left:${b.left.toFixed(2)}%;width:${b.width.toFixed(2)}%`}
      title={`${b.e.company}, ${b.e.period.en}`}
    ><span class="tape-career__name">{label(b)}</span>{!b.active && <Cross className="tape-career__x" />}</span>
  ))}
  {/* A bar too short for its name carries it beside the track instead */}
  {bars.filter(narrow).map((b) => (
    <span class="tape-career__callout" style={`left:${b.left.toFixed(2)}%`}>{label(b)}</span>
  ))}
  <span class="tape-career__flag"><Flag /></span>
  <div class="tape-career__years">
    {years.map((y) => <span style={`left:${pct(new Date(y, 0, 1)).toFixed(2)}%`}>{y}</span>)}
  </div>
</div>
<p class="tape-legend tape-caps" aria-hidden="true">
  <span><Band /> <T k="tape.active" /></span>
  <span><Cross /> <T k="tape.done" /></span>
  <span><Flag className="h-4 w-2" /> <T k="tape.now" /></span>
</p>
