---
import { skillGroups } from '@data/skills';
import TapeHeading from './TapeHeading.astro';
---
<div class="tape">
  <TapeHeading k="skills.title" />
  <dl class="tape-rows m-0">
    {skillGroups.map((g) => (
      <div class="tape-row">
        <dt class="tape-row__k tape-caps"><span data-lang-show="en">{g.category.en}</span><span data-lang-show="pt">{g.category.pt}</span></dt>
        <dd class="tape-row__v m-0">{g.skills.map((s) => <span>{s}</span>)}</dd>
      </div>
    ))}
  </dl>
</div>
