---
/**
 * 21:00, side projects after hours: the personal repositories (professional
 * work is told in Experience). Each title links to its repository, or to the
 * live site when there is no public code.
 */
import { projects } from '@data/projects';
import DioramaChapter from './DioramaChapter.astro';

const personal = projects.filter((p) => p.type === 'personal');
---

<DioramaChapter id="projects" titleKey="projects.title">
  <ul class="dio-projects">
    {personal.map((p) => (
      <li>
        <h3 class="dio-project">
          <a href={p.github ?? p.live} target="_blank" rel="noopener noreferrer" aria-label={p.github ? `${p.title} on GitHub` : `${p.title}, live site`}>{p.title}</a>
        </h3>
        <p class="dio-project__about">
          <span data-lang-show="en">{p.description.en}</span><span data-lang-show="pt">{p.description.pt}</span>
        </p>
        <ul class="dio-tags">
          {p.tech.map((x) => (
            <li>{x}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</DioramaChapter>
