---
/**
 * One hour of the day: a Diorama chapter. The stage reads every
 * [data-diorama-chapter] on the page, in order, as the stations of the day
 * (scene/Stage.tsx), so the camera reaches this chapter's station as its top
 * meets the top of the page. On wide screens the chapter is a row of the day's
 * page beside the room: its hour in the margin, level with its heading. On
 * phones it is a paper card under the room's band, where the clock shows the
 * hour (the margin is then read by assistive tech only). The scene's name is
 * always for assistive tech: the room shows it.
 */
import T from '@components/ui/T.astro';
import { STATIONS, clockText, type StationId } from './day';

interface Props {
  id: StationId;
  /** The chapter's heading, an i18n key (e.g. 'about.title'). */
  titleKey?: string;
}

const { id, titleKey } = Astro.props;
const station = STATIONS.find((s) => s.id === id);
if (!station) throw new Error(`DioramaChapter: unknown station "${id}"`);
const hour = clockText(station.hour);
---

<section class="dio-chapter" data-diorama-chapter={id} id={`dio-${id}`} data-diorama-hour={hour}>
  <div class="dio-card">
    {titleKey && <h2 class="dio-card__title"><T k={titleKey} /></h2>}
    <p class="dio-hour"><time datetime={hour}>{hour}</time> <span class="dio-hour__scene"><T k={`diorama.scene.${id}`} /></span></p>
    <div class="dio-card__body">
      <slot />
    </div>
  </div>
</section>
