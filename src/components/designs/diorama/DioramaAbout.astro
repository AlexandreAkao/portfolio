---
/**
 * 09:00, coffee: who he is, in his own two paragraphs. The card stands beside
 * the room while Akira reads the screen with the mug in hand. (No figures block:
 * its numbers are the headlines of the hours that follow.)
 */
import { t } from '@i18n/utils';
import DioramaChapter from './DioramaChapter.astro';
---

<DioramaChapter id="coffee" titleKey="about.title">
  <p class="dio-lede">
    <span data-lang-show="en">{t('about.p1', 'en')}</span><span data-lang-show="pt">{t('about.p1', 'pt')}</span>
  </p>
  <p class="dio-body">
    <span data-lang-show="en">{t('about.p2', 'en')}</span><span data-lang-show="pt">{t('about.p2', 'pt')}</span>
  </p>
</DioramaChapter>
