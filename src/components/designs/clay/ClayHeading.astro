---
import { t } from '@i18n/utils';

interface Props {
  k: string;
  /** The clay the coil under the title is rolled from. */
  coil?: 'pink' | 'orange' | 'purple' | 'lilac' | 'mint';
}

const { k, coil = 'pink' } = Astro.props;
---
{/* The section's title written as a component tag, like the site's <A4 /> mark,
    with a coil of clay rolled out under it. The brackets are decoration. */}
<h2 class="clay-h2">
  <span class="clay-h2__tag" aria-hidden="true">&lt;</span><span data-lang-show="en">{t(k, 'en')}</span><span data-lang-show="pt">{t(k, 'pt')}</span><span class="clay-h2__tag" aria-hidden="true">&nbsp;/&gt;</span>
  <svg class={`clay-coil clay-coil--${coil}`} viewBox="0 0 240 22" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="clay-coil__body" d="M8 13 C40 6 70 17 104 11 S170 5 200 12 S226 15 232 11" />
    <path class="clay-coil__lit" d="M14 10 C42 4 70 14 104 8 S168 3 198 9" />
  </svg>
</h2>
