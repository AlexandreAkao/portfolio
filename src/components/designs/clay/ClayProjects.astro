---
import { projects } from '@data/projects';
import ClayHeading from './ClayHeading.astro';

// Professional work is told in Experience (the hero's "View my work" leads there); this section keeps the personal work.
const personal = projects.filter((p) => p.type === 'personal');
const CLAYS = ['pink', 'orange', 'lilac', 'mint'];
---
{/* Each repository is a folder pressed in its own clay, its name on the tab */}
<div class="clay">
  <ClayHeading k="projects.title" coil="pink" />
  <ul class="clay-folders">
    {personal.map((p, i) => (
      <li class={`clay-folder clay-slab clay-slab--${CLAYS[i % CLAYS.length]}`} style={`--i:${i};--tx:${(i * 173 + 60) % 320}px;--ty:${(i * 89 + 130) % 320}px`}>
        <h3><a href={p.github ?? p.live} target="_blank" rel="noopener noreferrer" aria-label={p.github ? `${p.title} on GitHub` : `${p.title}, live site`}>{p.title}</a></h3>
        <p><span data-lang-show="en">{p.description.en}</span><span data-lang-show="pt">{p.description.pt}</span></p>
        <ul class="clay-beads clay-beads--on-clay">{p.tech.map((t) => <li>{t}</li>)}</ul>
      </li>
    ))}
  </ul>
</div>
