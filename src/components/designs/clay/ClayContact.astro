---
import { t } from '@i18n/utils';
import T from '@components/ui/T.astro';
import EmailCopy from '@components/islands/EmailCopy.tsx';
import { email } from '@data/social';
import CvLink from '@components/ui/CvLink.astro';
import ClayHeading from './ClayHeading.astro';
import ClayStill from './ClayStill.astro';
import EnterGlyph from './EnterGlyph';

interface Props {
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---
{/* Akira points across at the Enter key that writes to him */}
<div class="clay">
  <ClayHeading k="contact.title" coil="orange" />
  <div class="clay-contact">
    <p class="clay-contact__line">
      <span data-lang-show="en">{t('contact.description', 'en')}</span><span data-lang-show="pt">{t('contact.description', 'pt')}</span>
    </p>
    <ClayStill pose="point" class="clay-contact__akira" />
    <a href={`mailto:${email}`} class="clay-contact__send clay-key clay-key--pink clay-key--enter clay-key--xl"><T k="contact.emailMe" /><EnterGlyph /></a>
    <div class="clay-contact__more">
      <EmailCopy client:visible locale={locale} />
      <CvLink class="clay-key clay-key--lilac clay-key--sm" />
    </div>
  </div>
</div>
