---
import T from '@components/ui/T.astro';
import { education } from '@data/education';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';
import EngineerEducation from '@components/designs/engineer/EngineerEducation.astro';
import TerminalEducation from '@components/designs/terminal/TerminalEducation.astro';
import TapeEducation from '@components/designs/tape/TapeEducation.astro';
import CartoonEducation from '@components/designs/cartoon/CartoonEducation.astro';

---

<section id="education" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6" data-design-hide="engineer terminal tape cartoon">
    <ScrollReveal client:visible>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
        <span class="section-tag"><T k="education.title" /></span>
      </h2>
    </ScrollReveal>

    <div class="grid gap-6 md:grid-cols-2">
      {education.map((edu, i) => (
        <ScrollReveal client:visible delay={i * 0.1}>
          <div class="rounded-card border border-border bg-card p-6">
            <p class="mb-1 text-sm text-accent"><span data-lang-show="en">{edu.period.en}</span><span data-lang-show="pt">{edu.period.pt}</span></p>
            <h3 class="font-heading text-lg font-bold text-text">{edu.institution}</h3>
            <p class="text-text-secondary">
              <span data-lang-show="en">{edu.degree.en}</span>
              <span data-lang-show="pt">{edu.degree.pt}</span>
            </p>
            {edu.description && (
              <p class="mt-3 text-sm text-text-secondary">
                <span data-lang-show="en">{edu.description.en}</span>
                <span data-lang-show="pt">{edu.description.pt}</span>
              </p>
            )}
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="cartoon">
    <CartoonEducation />
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="tape">
    <TapeEducation />
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="terminal">
    <TerminalEducation />
  </div>

  {/* Engineer: section 3 of the draft */}
  <div class="px-6" data-design-show="engineer">
    <EngineerEducation />
  </div>
</section>
