---
import T from '@components/ui/T.astro';
import { education, inProgress } from '@data/education';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';
import KeepWords from '@components/ui/KeepWords.tsx';
import EngineerEducation from '@components/designs/engineer/EngineerEducation.astro';
import TerminalEducation from '@components/designs/terminal/TerminalEducation.astro';
import TapeEducation from '@components/designs/tape/TapeEducation.astro';
import CartoonEducation from '@components/designs/cartoon/CartoonEducation.astro';
import ClayEducation from '@components/designs/clay/ClayEducation.astro';

// Degrees grouped by the year they were finished, in data order; a group whose
// degrees share one period prints it once, beside the year, with whether it is
// still in progress.
const groups = new Map<string, { edu: (typeof education)[number]; i: number }[]>();
education.forEach((edu, i) => {
  const year = edu.end.slice(0, 4);
  groups.set(year, [...(groups.get(year) ?? []), { edu, i }]);
});

// The year ruler: one column per year from the first start to the last end, each
// degree a bar on the first track free at its start, so parallel degrees stack.
const month = (ym: string) => Number(ym.slice(0, 4)) + (Number(ym.slice(5, 7)) - 1) / 12;
const from = Math.min(...education.map((e) => Math.floor(month(e.start))));
const to = Math.max(...education.map((e) => Math.floor(month(e.end)))) + 1;
const years = Array.from({ length: to - from }, (_, k) => from + k);
const trackEnds: number[] = [];
const bars = education
  .map((edu, i) => ({ i, start: month(edu.start), end: month(edu.end) }))
  .sort((a, b) => a.start - b.start)
  .map((bar) => {
    let track = trackEnds.findIndex((end) => end <= bar.start);
    if (track === -1) track = trackEnds.push(0) - 1;
    trackEnds[track] = bar.end;
    const left = ((bar.start - from) / (to - from)) * 100;
    const width = ((bar.end - bar.start) / (to - from)) * 100;
    return { i: bar.i, track, style: `left:${left}%;width:${width}%` };
  });
---

<section id="education" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6" data-design-hide="engineer terminal tape cartoon clay">
    <ScrollReveal client:visible>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
        <span class="section-tag"><T k="education.title" /></span>
      </h2>
    </ScrollReveal>

    <div class="edu">
      {/* The ruler shows the shape at a glance (the bachelor, then the two
          postgraduate degrees); the list below carries every fact as text. */}
      <ScrollReveal client:visible>
        <div class="edu-ruler mb-10 md:mb-14" style={`--years:${years.length};--tracks:${trackEnds.length}`} aria-hidden="true">
          <div class="edu-ruler__tracks">
            {bars.map((bar) => (
              <span class="edu-ruler__bar" data-bar={bar.i} style={`${bar.style};--track:${bar.track}`}></span>
            ))}
          </div>
          <div class="edu-ruler__years">
            {years.map((y) => (
              <span><span class="md:hidden">’{String(y).slice(2)}</span><span class="hidden md:inline">{y}</span></span>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ol>
        {[...groups].map(([year, list], g) => {
          const shared = list.every(({ edu }) => edu.period.en === list[0].edu.period.en);
          return (
            <li class:list={[g > 0 && 'mt-12']}>
              <ScrollReveal client:visible delay={g * 0.1}>
                <div class="grid gap-4 border-t border-border pt-8 md:grid-cols-[1fr_2fr] md:gap-8">
                  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 md:block">
                    <p class="font-heading text-[clamp(3rem,7vw,5.5rem)] font-bold leading-[0.85] tracking-[-0.02em] text-text">{year}</p>
                    {shared && (
                      <div class="text-xs font-semibold uppercase tracking-[0.15em] md:mt-3">
                        <p class="whitespace-nowrap text-text-secondary">
                          <span data-lang-show="en">{list[0].edu.period.en}</span><span data-lang-show="pt">{list[0].edu.period.pt}</span>
                        </p>
                        {inProgress(list[0].edu) && <p class="mt-1 text-accent"><T k="education.inProgress" /></p>}
                      </div>
                    )}
                  </div>
                  <div>
                    {list.map(({ edu, i }, j) => (
                      <article data-edu={i} class:list={[j > 0 && 'mt-6 border-t border-border pt-6']}>
                        <h3 class="max-w-[22ch] text-balance font-heading text-[clamp(1.375rem,2.6vw,2rem)] font-bold leading-[1.1] text-text">
                          <span data-lang-show="en"><KeepWords text={edu.degree.en} /></span><span data-lang-show="pt"><KeepWords text={edu.degree.pt} /></span>
                        </h3>
                        <p class="mt-2 font-medium text-accent">{edu.institution}</p>
                        {!shared && (
                          <p class="mt-1 text-xs font-semibold uppercase tracking-[0.15em] text-text-secondary">
                            <span data-lang-show="en">{edu.period.en}</span><span data-lang-show="pt">{edu.period.pt}</span>
                            {inProgress(edu) && <span class="text-accent"> · <T k="education.inProgress" /></span>}
                          </p>
                        )}
                        {edu.description && (
                          <p class="mt-3 max-w-prose text-sm text-text-secondary">
                            <span data-lang-show="en">{edu.description.en}</span>
                            <span data-lang-show="pt">{edu.description.pt}</span>
                          </p>
                        )}
                      </article>
                    ))}
                  </div>
                </div>
              </ScrollReveal>
            </li>
          );
        })}
      </ol>
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="clay">
    <ClayEducation />
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="cartoon">
    <CartoonEducation />
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="tape">
    <TapeEducation />
  </div>

  <div class="mx-auto max-w-4xl px-6" data-design-show="terminal">
    <TerminalEducation />
  </div>

  {/* Engineer: section 3 of the draft */}
  <div class="px-6" data-design-show="engineer">
    <EngineerEducation />
  </div>
</section>
