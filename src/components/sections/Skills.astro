---
import T from '@components/ui/T.astro';
import { skillGroups } from '@data/skills';
import EngineerSkills from '@components/designs/engineer/EngineerSkills.tsx';
import CreativeSkills from '@components/designs/creative/CreativeSkills.tsx';
import AvantgardeSkills from '@components/designs/avantgarde/AvantgardeSkills.tsx';
import EditorialSkills from '@components/designs/editorial/EditorialSkills.tsx';
import ArcadeSkills from '@components/designs/arcade/ArcadeSkills.tsx';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<section id="skills" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <ScrollReveal client:visible>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
        <span class="section-tag"><T k="skills.title" /></span>
      </h2>
    </ScrollReveal>

    <div data-design-show="engineer">
      <EngineerSkills skillGroups={skillGroups} locale={locale} client:visible />
    </div>
    <div data-design-show="creative">
      <CreativeSkills skillGroups={skillGroups} locale={locale} client:visible />
    </div>
    <div data-design-show="avantgarde">
      <AvantgardeSkills skillGroups={skillGroups} locale={locale} client:visible />
    </div>
    <div data-design-show="editorial">
      <EditorialSkills skillGroups={skillGroups} locale={locale} client:visible />
    </div>
    <div data-design-show="arcade">
      <ArcadeSkills skillGroups={skillGroups} locale={locale} client:visible />
    </div>
  </div>
</section>
