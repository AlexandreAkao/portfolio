---
import T from '@components/ui/T.astro';
import { projects } from '@data/projects';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';
import { Icon } from 'astro-icon/components';

const professional = projects.filter((p) => p.type === 'professional');
const personal = projects.filter((p) => p.type === 'personal');
---

<section id="projects" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <ScrollReveal client:visible>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
        <span class="section-tag"><T k="projects.title" /></span>
      </h2>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.1}>
      <h3 class="mb-6 font-heading text-xl font-semibold text-accent">
        <T k="projects.professional" />
      </h3>
      {/* Professional work is told in Experience; here it is one ruled line each, pointing back there */}
      <ul class="mb-12 border-t border-border">
        {professional.map((project) => (
          <li class="border-b border-border">
            <a
              href="#experience"
              class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
            >
              <span class="font-heading text-lg font-bold text-text transition-colors group-hover:text-accent">
                {project.title}
              </span>
              {project.metrics && (
                <span class="text-sm font-medium text-accent">
                  <span data-lang-show="en">{project.metrics.en}</span>
                  <span data-lang-show="pt">{project.metrics.pt}</span>
                </span>
              )}
              <span class="sr-only"><T k="projects.seeExperience" /></span>
            </a>
          </li>
        ))}
      </ul>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.1}>
      <h3 class="mb-6 font-heading text-xl font-semibold text-accent">
        <T k="projects.personal" />
      </h3>
    </ScrollReveal>
    <div class="grid border-t border-border sm:gap-6 sm:border-t-0 md:grid-cols-2 lg:grid-cols-3">
      {personal.map((project, i) => (
        <ScrollReveal client:visible delay={i * 0.05}>
          <div class="flex h-full flex-col border-b border-border py-4 transition-colors sm:rounded-card sm:border sm:bg-card sm:p-6 sm:hover:border-accent/50">
            <div class="mb-2 flex items-start justify-between gap-4 sm:mb-3">
              <div>
                <Icon name="lucide:folder" class="mb-3 hidden h-8 w-8 text-accent sm:block" />
                <h4 class="font-heading text-lg font-bold text-text">{project.title}</h4>
              </div>
              <div class="flex gap-3 pt-1">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} on GitHub`} class="-m-3 inline-flex p-3 text-text-secondary transition-colors hover:text-accent md:m-0 md:p-0">
                    <Icon name="lucide:github" class="h-5 w-5" />
                  </a>
                )}
                {project.live && (
                  <a href={project.live} target="_blank" rel="noopener noreferrer" aria-label={`${project.title}, live site`} class="-m-3 inline-flex p-3 text-text-secondary transition-colors hover:text-accent md:m-0 md:p-0">
                    <Icon name="lucide:external-link" class="h-5 w-5" />
                  </a>
                )}
              </div>
            </div>
            <p class="flex-1 text-sm text-text-secondary sm:mb-4">
              <span data-lang-show="en">{project.description.en}</span>
              <span data-lang-show="pt">{project.description.pt}</span>
            </p>
            <div class="hidden flex-wrap gap-1 sm:flex">
              {project.tech.map((t) => (
                <span class="rounded-btn border border-border px-2 py-0.5 text-xs text-text-secondary">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
