---
import { t } from '@i18n/utils';
import T from '@components/ui/T.astro';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';
import EmailCopy from '@components/islands/EmailCopy.tsx';
import { cvUrl, email } from '@data/social';
import EngineerContact from '@components/designs/engineer/EngineerContact.astro';
import TerminalContact from '@components/designs/terminal/TerminalContact.astro';
import TapeContact from '@components/designs/tape/TapeContact.astro';

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<section id="contact" class="py-12 md:py-20">
  <div class="mx-auto max-w-2xl px-6 text-center" data-design-hide="engineer terminal tape">
    <ScrollReveal client:visible>
      <h2 class="mb-4 font-heading text-3xl font-bold text-text">
        <span class="section-tag"><T k="contact.title" /></span>
      </h2>
      <p class="mb-8 text-text-secondary">
        <span data-lang-show="en">{t('contact.description', 'en')}</span>
        <span data-lang-show="pt">{t('contact.description', 'pt')}</span>
      </p>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.1}>
      <a
        href={`mailto:${email}`}
        class="inline-block w-full rounded-btn bg-accent px-6 py-3 font-heading text-sm font-semibold text-on-accent transition-colors hover:bg-accent-hover"
      >
        <T k="contact.emailMe" />
      </a>

      <div class="mt-6 flex flex-col items-center gap-2 text-sm sm:flex-row sm:justify-center sm:gap-8">
        <EmailCopy client:visible locale={locale} />
        <a
          href={cvUrl}
          download
          class="inline-flex min-h-11 items-center font-medium text-text underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-accent md:min-h-0"
        >
          <T k="hero.cta.cv" />
        </a>
      </div>
    </ScrollReveal>
  </div>

  {/* Tape: the address in a punched window, the Email key as a whole orange frame */}
  <div class="mx-auto max-w-4xl px-6" data-design-show="tape">
    <TapeContact locale={locale} />
  </div>

  {/* Terminal: `mail`, the composer waiting on a subject, the address copyable */}
  <div class="mx-auto max-w-4xl px-6" data-design-show="terminal">
    <TerminalContact locale={locale} />
  </div>

  {/* Engineer: the draft's Author's Address, the Email key the one fill on the page */}
  <div class="px-6" data-design-show="engineer">
    <EngineerContact locale={locale} />
  </div>
</section>
