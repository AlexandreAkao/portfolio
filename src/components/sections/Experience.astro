---
import T from '@components/ui/T.astro';
import { experiences } from '@data/experience';
import EngineerTimeline from '@components/designs/engineer/EngineerTimeline.tsx';
import CreativeCarousel from '@components/designs/creative/CreativeCarousel.tsx';
import AvantgardeExperience from '@components/designs/avantgarde/AvantgardeExperience.tsx';
import EditorialExperience from '@components/designs/editorial/EditorialExperience.tsx';
import ArcadeExperience from '@components/designs/arcade/ArcadeExperience.tsx';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<section id="experience" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <ScrollReveal client:visible>
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
        <span class="section-tag"><T k="experience.title" /></span>
      </h2>
    </ScrollReveal>

    <div data-design-show="engineer">
      <EngineerTimeline experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="creative">
      <CreativeCarousel experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="avantgarde">
      <AvantgardeExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="editorial">
      <EditorialExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="arcade">
      <ArcadeExperience experiences={experiences} locale={locale} client:visible />
    </div>
  </div>
</section>
