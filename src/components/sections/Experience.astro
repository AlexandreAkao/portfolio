---
import T from '@components/ui/T.astro';
import { experiences } from '@data/experience';
import EngineerTimeline from '@components/designs/engineer/EngineerTimeline.tsx';
import CreativeCarousel from '@components/designs/creative/CreativeCarousel.tsx';
import AvantgardeExperience from '@components/designs/avantgarde/AvantgardeExperience.tsx';
import EditorialExperience from '@components/designs/editorial/EditorialExperience.tsx';
import ArcadeExperience from '@components/designs/arcade/ArcadeExperience.tsx';
import ScrollReveal from '@components/islands/ScrollReveal.tsx';
import RfcHeading from '@components/designs/engineer/RfcHeading.astro';
import TerminalExperience from '@components/designs/terminal/TerminalExperience.tsx';
import Prompt from '@components/designs/terminal/Prompt.astro';
import TapeExperience from '@components/designs/tape/TapeExperience.tsx';
import TapeCareer from '@components/designs/tape/TapeCareer.astro';
import TapeHeading from '@components/designs/tape/TapeHeading.astro';
import CartoonExperience from '@components/designs/cartoon/CartoonExperience.tsx';
import CartoonHeading from '@components/designs/cartoon/CartoonHeading.astro';

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<section id="experience" class="py-12 md:py-20">
  <div class="mx-auto max-w-4xl px-6">
    <div data-design-hide="engineer terminal tape cartoon">
      <ScrollReveal client:visible>
        <h2 class="mb-8 text-center font-heading text-3xl font-bold text-text md:mb-12">
          <span class="section-tag"><T k="experience.title" /></span>
        </h2>
      </ScrollReveal>
    </div>

    <div data-design-show="engineer" class="rfc-col">
      <RfcHeading n="2." k="experience.title" />
      <EngineerTimeline experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="terminal" class="term term-block">
      <Prompt cmd="cat experience.log" k="experience.title" />
      <TerminalExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="tape" class="tape">
      <TapeHeading k="experience.title" />
      <TapeCareer />
      <TapeExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="cartoon" class="cartoon">
      <CartoonHeading k="experience.title" seed={1} />
      <CartoonExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="creative">
      <CreativeCarousel experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="avantgarde">
      <AvantgardeExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="editorial">
      <EditorialExperience experiences={experiences} locale={locale} client:visible />
    </div>
    <div data-design-show="arcade">
      <ArcadeExperience experiences={experiences} locale={locale} client:visible />
    </div>
  </div>
</section>
