---
// Intro curtain: one authored entrance per design world, played on every
// arrival at the site (hard loads only; ClientRouter navigations skip it).
// Gated by <html data-intro="wait|play">, set before paint in BaseLayout.
// Reduced-motion visitors never see it, and the page stays fully usable
// without JS because the curtain is display:none until the flag is set.
import TapeStrip from '@components/designs/tape/TapeStrip';
import Lettering from '@components/designs/cartoon/Lettering';
import T from '@components/ui/T.astro';
import { t } from '@i18n/utils';
import { RFC_FILE, rfcDate } from '@components/designs/engineer/rfc';
import { loginDate } from '@components/designs/terminal/session';
import { socialLinks } from '@data/social';

// Engineer: the draft's pages after the first, with what the pager's status line
// reads on each (the section on screen, how far through the file).
const draftPages = [
  { page: 2, n: '1.', k: 'rfc.intro', pct: '14%' },
  { page: 3, n: '2.', k: 'experience.title', pct: '29%' },
  { page: 4, n: '3.', k: 'education.title', pct: '43%' },
  { page: 5, n: '4.', k: 'skills.title', pct: '57%' },
  { page: 6, n: '5.', k: 'projects.title', pct: '71%' },
  { page: 7, n: '6.', k: 'rfc.address', pct: '86%' },
  { page: 8, n: '7.', k: 'rfc.references', pct: '' },
];
const draftDate = { en: rfcDate('en'), pt: rfcDate('pt') };
const login = { en: loginDate('en'), pt: loginDate('pt') };

// Tape: the hero's own tape (name, then role, in real ASCII), and its window's
// lines cut into one span per character so the reader can print them one by one.
// Hyphenated words stay unbroken, as KeepWords keeps them in the hero.
const punched = `${t('hero.name', 'en').toUpperCase()} . ${t('hero.title', 'en').toUpperCase()} . `;
const printable = (text: string) =>
  text.split(/(\S+-\S+)/).filter(Boolean).map((part) => ({ keep: part.includes('-'), chars: [...part] }));
---

<div id="site-intro" aria-hidden="true">
  <!-- Avant-garde: the name sharpens out of blur, a lime rule draws, the stage splits open -->
  <div class="intro intro-ag" data-design-show="avantgarde">
    <div class="intro-ag__panel intro-ag__panel--top"></div>
    <div class="intro-ag__panel intro-ag__panel--bottom"></div>
    <div class="intro-ag__stage">
      <p class="intro-ag__name">Alexandre Akira</p>
      <span class="intro-ag__rule"></span>
    </div>
  </div>

  <!-- Engineer: the draft opens at its end, (END) on page 8, then the pager pages
       back one whole screen at a time to page 1, where the hero prints. The script
       turns the pages; the status line is drawn as the page's pinned pager, so it
       stays put through the cut. -->
  <div class="intro intro-eng" data-design-show="engineer">
    <div class="intro-eng__reel">
      <div class="intro-eng__page"></div>
      {draftPages.map((p) => (
        <div class="intro-eng__page">
          <div class="rfc-col rfc-seam">
            <div class="rfc-seam__ln">
              <span><T k="rfc.draft" /></span><span><T k="hero.title" /></span><span><span data-lang-show="en">{draftDate.en}</span><span data-lang-show="pt">{draftDate.pt}</span></span>
            </div>
          </div>
          <div class="rfc-col intro-eng__body">
            <p class="rfc-h"><span class="rfc-n">{p.n}</span><T k={p.k} /></p>
            {p.page === 8 && (
              <dl class="rfc-refs">
                {socialLinks.map((link) => (
                  <>
                    <dt>[{link.name.toUpperCase().replace('.', '')}]</dt>
                    <dd><span class="intro-eng__a">{link.url.replace('mailto:', '')}</span></dd>
                  </>
                ))}
              </dl>
            )}
          </div>
          <div class="rfc-col rfc-seam intro-eng__foot">
            <div class="rfc-seam__ln">
              <span>Akira</span><span><T k="rfc.informational" /></span><span>[<T k="rfc.page" /> {p.page}]</span>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="rfc-pager">
      <span class="rfc-pager__file">{RFC_FILE}</span>
      <span class="rfc-pager__sec" data-eng-sec><span class="rfc-n">7.</span><T k="rfc.references" /></span>
      <span class="rfc-pager__pct" data-eng-pct data-end><T k="rfc.end" /></span>
    </div>
    <div hidden>
      <span data-eng-row><span><T k="rfc.abstract" /></span><span>0%</span></span>
      {draftPages.map((p) => (
        <span data-eng-row data-end={p.page === 8 ? '' : undefined}>
          <span><span class="rfc-n">{p.n}</span><T k={p.k} /></span>
          <span>{p.page === 8 ? <T k="rfc.end" /> : p.pct}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Cartoon: the titles open. "Alexandre Akira presents" is lettered on the black
       leader, cut, then an iris opens on Akira's face (the script finds it in the
       hero) onto the hero's own title card, whose entrance plays as it opens. -->
  <div class="intro intro-cart" data-design-show="cartoon">
    <div class="intro-cart__leader"></div>
    <p class="intro-cart__card">
      <span data-lang-show="en"><Lettering text={t('cartoon.presents', 'en')} /></span><span data-lang-show="pt"><Lettering text={t('cartoon.presents', 'pt')} /></span>
    </p>
  </div>

  <!-- Clay: on the painted sweep, </> is rolled out in three coils of clay, one
       piece per beat on twos, the name pressed under it; then the glyph is
       squashed flat and lifted away onto the hero's own set. -->
  <div class="intro intro-clay" data-design-show="clay">
    <div class="intro-clay__sweep"></div>
    <div class="intro-clay__glyph">
      <svg class="intro-clay__coils" viewBox="0 0 260 150" aria-hidden="true" focusable="false">
        <g class="intro-clay__coil intro-clay__coil--lt"><path class="intro-clay__body" d="M86 24 L32 75 L86 126" /><path class="intro-clay__lit" d="M82 22 L30 71" /></g>
        <g class="intro-clay__coil intro-clay__coil--sl"><path class="intro-clay__body" d="M150 16 L110 134" /><path class="intro-clay__lit" d="M146 16 L112 118" /></g>
        <g class="intro-clay__coil intro-clay__coil--gt"><path class="intro-clay__body" d="M174 24 L228 75 L174 126" /><path class="intro-clay__lit" d="M178 22 L226 70" /></g>
      </svg>
      <p class="intro-clay__name">{t('hero.name', 'en')}</p>
    </div>
  </div>

  <!-- Arcade: READY? pops and blinks, then five candy bars sweep the screen clean -->
  <div class="intro intro-arc" data-design-show="arcade">
    <div class="intro-arc__cabinet">
      <p class="intro-arc__ready">Ready?</p>
    </div>
    <div class="intro-arc__bars">
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    var html = document.documentElement;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var active = null;

    // Engineer: put one page of the draft on screen, and the status line it reads.
    function draftPage(block, page) {
      var row = block.querySelectorAll('[data-eng-row]')[page - 1];
      var sec = block.querySelector('[data-eng-sec]');
      var pct = block.querySelector('[data-eng-pct]');
      if (!row || !sec || !pct) return;
      block.style.setProperty('--eng-page', String(page));
      sec.innerHTML = row.children[0].innerHTML;
      pct.innerHTML = row.children[1].innerHTML;
      if (row.hasAttribute('data-end')) pct.dataset.end = '';
      else delete pct.dataset.end;
    }

    // Terminal: set the remote session's first lines exactly on the hero's, so
    // lifting the curtain changes nothing on screen.
    function sshPlace(block) {
      var box = block.querySelector('.intro-ssh');
      var mine = block.querySelector('.intro-ssh__login');
      var hero = document.querySelector('#hero [data-design-show="terminal"] .term > .term-muted');
      if (!box || !mine || !hero) return;
      var r = hero.getBoundingClientRect();
      if (!r.width) return;
      box.style.left = r.left + 'px';
      box.style.width = r.width + 'px';
      box.style.top = Math.max(0, r.top - mine.offsetTop) + 'px';
    }

    // Where an element sits on screen without its own transform: the hero's
    // window is still at its entrance offset when it is measured under the curtain.
    function untransformed(el) {
      var r = el.getBoundingClientRect();
      var t = getComputedStyle(el).transform;
      var m = t && t !== 'none' ? new DOMMatrixReadOnly(t) : null;
      return { left: r.left - (m ? m.m41 : 0), top: r.top - (m ? m.m42 : 0), width: r.width };
    }

    // Tape: set the window and the tape on the hero's own.
    function tapePlace(block) {
      var hero = document.querySelector('#hero [data-design-show="tape"]');
      var win = block.querySelector('.intro-tape__win');
      var band = block.querySelector('.intro-tape__band');
      var heroWin = hero && hero.querySelector('.tape-win');
      var heroBand = hero && hero.querySelector('.tape-band');
      if (win && heroWin) {
        var w = untransformed(heroWin);
        win.style.left = w.left + 'px';
        win.style.top = w.top + 'px';
        win.style.width = w.width + 'px';
      }
      // On a short phone the hero's tape sits below the fold: read it on screen instead
      if (band && heroBand) band.style.top = Math.min(untransformed(heroBand).top, window.innerHeight - heroBand.offsetHeight - 24) + 'px';
      block.dataset.ready = '';
    }

    // The reader: 44 columns pass (the name, the " . " line feed, the role). The
    // tape moves in whole columns, as far as the screen shows well (all 44 on a
    // wide one), and ends where the hero's tape stands.
    var TAPE_NAME = 15, TAPE_FEED = 3, TAPE_COLS = 44;
    function tapeTravel() {
      return Math.max(8, Math.min(TAPE_COLS, Math.floor((window.innerWidth * 0.55) / 14)));
    }
    function tapeAt(block, col, travel) {
      var feed = block.querySelector('.intro-tape__feed');
      if (feed) feed.style.setProperty('--tape-at', String(TAPE_COLS - travel + Math.round((col * travel) / TAPE_COLS)));
    }
    function tapeRead(block, col, travel) {
      tapeAt(block, col + 1, travel);
      if (col < TAPE_NAME) {
        var ch = block.querySelectorAll('[data-tape-name] [data-ch]')[col];
        if (ch) ch.dataset.on = '';
      } else if (col >= TAPE_NAME + TAPE_FEED) {
        // The tape carries the English role; a role of another length prints in step with it
        var r = col - TAPE_NAME - TAPE_FEED + 1, of = TAPE_COLS - TAPE_NAME - TAPE_FEED;
        block.querySelectorAll('[data-tape-role]').forEach(function (role) {
          var chs = role.querySelectorAll('[data-ch]');
          for (var i = 0; i < Math.ceil((r * chs.length) / of); i++) chs[i].dataset.on = '';
        });
      }
    }

    // Cartoon: centre the iris on the face of the hero's painter. The drawing may
    // be mid-entrance (scaled), so it is read off its untransformed box: the face
    // sits 0.327 of the drawing's height right of its cell and 0.6455 above its foot.
    function cartPlace(block) {
      var cell = document.querySelector('#hero [data-design-show="cartoon"] [data-cartoon-painter]');
      var art = cell && cell.querySelector('.cartoon-painter__art');
      if (!art) return;
      var c = cell.getBoundingClientRect();
      var h = parseFloat(getComputedStyle(art).height);
      if (!c.width || !h) return;
      block.style.setProperty('--ix', Math.round(c.left + 0.327 * h) + 'px');
      block.style.setProperty('--iy', Math.round(c.bottom - 0.6455 * h) + 'px');
    }

    // Curtains staged by script as well as CSS. prepare() runs before the curtain
    // shows; start() when it begins to move: after the font wait on arrival, and
    // once the theme has swapped underneath on a quick change, so the incoming
    // hero is laid out and can be measured. A paced stage calls done() when its
    // sequence is over; otherwise a holding curtain is due at its reveal.
    var stages = {
      engineer: {
        prepare: function (block) { draftPage(block, 8); },
        start: function (block, mode, later) {
          var first = mode === 'arrival' ? 700 : 30;
          var every = mode === 'arrival' ? 85 : 50;
          for (var p = 7; p >= 1; p--) later(draftPage.bind(null, block, p), first + (7 - p) * every);
        }
      },
      terminal: {
        start: function (block) { sshPlace(block); }
      },
      cartoon: {
        start: function (block) { cartPlace(block); }
      },
      tape: {
        paced: true,
        prepare: function (block, mode) {
          delete block.dataset.ready;
          block.querySelectorAll('[data-ch]').forEach(function (ch) { delete ch.dataset.on; });
          // A quick change keeps the name printed and reads only the role
          if (mode === 'quick') block.querySelectorAll('[data-tape-name] [data-ch]').forEach(function (ch) { ch.dataset.on = ''; });
          tapeAt(block, mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0, tapeTravel());
        },
        start: function (block, mode, later, done) {
          var travel = tapeTravel();
          tapeAt(block, mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0, travel);
          tapePlace(block);
          var at = mode === 'arrival' ? 150 : 30;
          for (var col = mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0; col < TAPE_COLS; col++) {
            later(tapeRead.bind(null, block, col, travel), at);
            at += mode === 'quick' ? 11 : col < TAPE_NAME ? 36 : col < TAPE_NAME + TAPE_FEED ? 40 : 16;
          }
          later(done, at + (mode === 'quick' ? 60 : 130));
        }
      }
    };

    // One curtain session. mode "arrival": the full intro armed by BaseLayout
    // (data-intro="wait"). mode "quick": a theme switch; the curtain wears the
    // incoming world, covers the page, the theme swaps underneath, then the
    // world's exit gesture reveals it.
    function run(mode, opts) {
      var el = document.getElementById('site-intro');
      if (!el) return null;
      var world = mode === 'arrival' ? html.dataset.design : opts.design;
      var block = el.querySelector('.intro[data-design-show="' + world + '"]');
      var stage = (block && stages[world]) || {};
      // A curtain that holds ends on the frame its hero starts from, so it lifts only
      // once that hero is in place underneath; --intro-total is the cap. It lifts
      // with a cut (Terminal), or with data-intro-hold="fade" by fading away while
      // the page comes up around what the two share (Tape).
      var hold = block ? block.getAttribute('data-intro-hold') : null;
      var holds = hold !== null;
      var s = { revealed: false, finished: false, applied: false, started: false, due: false, heroReady: false, timers: [] };
      active = s;

      function later(fn, ms) {
        s.timers.push(setTimeout(fn, ms));
      }
      function begin() {
        if (s.started || s.finished) return;
        s.started = true;
        if (stage.start) stage.start(block, mode, later, due);
      }
      function due() {
        s.due = true;
        lift();
      }
      // A hero hydrated earlier (a later switch back to its world) will not reset again
      function heroLive() {
        return !!document.querySelector('#hero [data-design-show="' + world + '"] astro-island:not([ssr])');
      }
      function lift() {
        if (!s.due || s.lifting || !(s.heroReady || heroLive())) return;
        if (hold !== 'fade' || !el.animate) { finish(); return; }
        s.lifting = el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: mode === 'quick' ? 280 : 350, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' });
        s.lifting.onfinish = finish;
      }
      function onHeroReady(e) {
        if (e.detail !== world) return;
        s.heroReady = true;
        lift();
      }
      function reveal() {
        if (s.revealed) return;
        s.revealed = true;
        if (html.dataset.intro === 'play') html.dataset.intro = 'reveal';
        document.dispatchEvent(new CustomEvent('site-intro:reveal'));
      }
      function applyTheme() {
        if (s.applied) return;
        s.applied = true;
        if (opts && opts.apply) opts.apply();
        if (mode === 'quick') begin();
      }
      function finish() {
        if (s.finished) return;
        s.finished = true;
        if (mode === 'arrival') reveal();
        applyTheme();
        html.dataset.intro = 'done';
        delete el.dataset.design;
        el.removeEventListener('animationend', onEnd);
        el.removeEventListener('click', finish);
        el.removeEventListener('wheel', finish);
        el.removeEventListener('touchmove', finish);
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('site-hero:ready', onHeroReady);
        clearTimeout(s.timer);
        clearTimeout(s.applyTimer);
        s.timers.forEach(clearTimeout);
        if (s.lifting) s.lifting.cancel();
        active = null;
        document.dispatchEvent(new CustomEvent('site-intro:done'));
      }
      function onEnd(e) {
        if (e.target !== el) return;
        if (e.animationName === 'intro-reveal') {
          if (mode !== 'arrival') return;
          reveal();
          if (holds && !stage.paced) due();
        }
        else if (e.animationName === 'intro-root') finish();
      }
      function onKey(e) {
        if (e.key === 'Escape') finish();
      }
      function play() {
        if (html.dataset.intro !== 'wait') return;
        begin();
        html.dataset.intro = 'play';
      }

      if (stage.prepare) stage.prepare(block, mode);
      if (holds) document.addEventListener('site-hero:ready', onHeroReady);
      el.addEventListener('animationend', onEnd);
      el.addEventListener('click', finish);
      // A scroll gesture means "let me read": it ends the curtain instead of being swallowed.
      // (touchmove, not touchstart, so a tap cannot fall through onto a link underneath.)
      el.addEventListener('wheel', finish, { passive: true });
      el.addEventListener('touchmove', finish, { passive: true });
      document.addEventListener('keydown', onKey);
      s.timer = setTimeout(finish, mode === 'arrival' ? 4000 : 2000);

      if (mode === 'arrival' && el.querySelector('[data-design-show="' + html.dataset.design + '"][data-intro-no-font-wait]')) {
        // This world's curtain carries no type that needs its face: play at once.
        play();
      } else if (mode === 'arrival') {
        // Hold the curtain still until the world's display face is ready, so
        // the first frame is set in the right type. Never wait longer than 700ms.
        var fontsReady = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
        var fontTimer = setTimeout(play, 700);
        fontsReady.then(function () { clearTimeout(fontTimer); play(); }, play);
      } else {
        el.dataset.design = opts.design;
        html.dataset.intro = 'quick';
        s.applyTimer = setTimeout(applyTheme, 170);
        if (holds && !stage.paced) later(due, 450);
      }
      return s;
    }

    if (html.dataset.intro === 'wait') run('arrival');

    // Called by DesignToggle. Returns false when the caller should use its own
    // transition instead (reduced motion, a curtain already running, or an
    // unknown world).
    window.siteIntro = {
      quickChange: function (design, apply) {
        var el = document.getElementById('site-intro');
        if (reduce || active || !el || !el.querySelector('[data-design-show="' + design + '"]')) return false;
        return !!run('quick', { design: design, apply: apply });
      }
    };
  })();
</script>

<style is:global>
  /* ---------- Curtain root ---------- */
  #site-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9990;
    overflow: hidden;
    cursor: default;
    animation:
      intro-reveal 1ms linear var(--intro-reveal, 1s) forwards,
      intro-root 1ms linear var(--intro-total, 1.6s) forwards;
  }
  html[data-intro='wait'] #site-intro,
  html[data-intro='play'] #site-intro,
  html[data-intro='reveal'] #site-intro {
    display: block;
  }
  html[data-intro='wait'] #site-intro,
  html[data-intro='wait'] #site-intro * {
    animation-play-state: paused;
  }
  @keyframes intro-reveal {
    to { outline-offset: 1px; }
  }
  @keyframes intro-root {
    to { visibility: hidden; }
  }

  .intro {
    position: absolute;
    inset: 0;
  }

  /* --intro-reveal: when the exit begins (heroes hydrate); --intro-total: when the curtain is gone */
  [data-design='avantgarde'] #site-intro { --intro-reveal: 1.05s; --intro-total: 1.75s; }
  [data-design='engineer']   #site-intro { --intro-reveal: 1.25s; --intro-total: 1.3s; }
  [data-design='editorial']  #site-intro { --intro-reveal: 0.95s; --intro-total: 1.65s; }
  [data-design='arcade']     #site-intro { --intro-reveal: 1.25s; --intro-total: 1.9s; }
  /* Terminal lifts as soon as its hero has reset under it (see data-intro-hold); 2.2s is the cap */
  [data-design='terminal']   #site-intro { --intro-reveal: 1.3s; --intro-total: 2.2s; }
  /* Tape hydrates its hero early (underneath, already in place) and fades when the reader is done; 2.6s cap */
  [data-design='tape']       #site-intro { --intro-reveal: 0.4s; --intro-total: 2.6s; }
  [data-design='cartoon']    #site-intro { --intro-reveal: 1s; --intro-total: 1.65s; }
  [data-design='clay']       #site-intro { --intro-reveal: 0.95s; --intro-total: 1.2s; }

  /* ---------- Quick-change (theme switch): the incoming world's exit gesture only ---------- */
  /* The curtain carries the incoming design on its own data-design so it can
     wear the new tokens and show the new world's block while <html> still
     holds the old design for the first 170ms. */
  #site-intro[data-design] [data-design-show] { display: none !important; }
  #site-intro[data-design='avantgarde'] [data-design-show='avantgarde'],
  #site-intro[data-design='engineer'] [data-design-show='engineer'],
  #site-intro[data-design='editorial'] [data-design-show='editorial'],
  #site-intro[data-design='arcade'] [data-design-show='arcade'],
  #site-intro[data-design='terminal'] [data-design-show='terminal'],
  #site-intro[data-design='tape'] [data-design-show='tape'],
  #site-intro[data-design='cartoon'] [data-design-show='cartoon'],
  #site-intro[data-design='clay'] [data-design-show='clay'] { display: block !important; }

  html[data-intro='quick'] #site-intro {
    display: block;
    --intro-reveal: 1ms;
    animation:
      intro-in 0.15s ease-out both,
      intro-reveal 1ms linear var(--intro-reveal) forwards,
      intro-root 1ms linear var(--intro-total) forwards;
  }
  @keyframes intro-in { from { opacity: 0; } }
  html[data-intro='quick'] #site-intro[data-design='avantgarde'] { --intro-total: 0.8s; }
  html[data-intro='quick'] #site-intro[data-design='engineer']   { --intro-total: 0.55s; }
  html[data-intro='quick'] #site-intro[data-design='editorial']  { --intro-total: 0.75s; }
  html[data-intro='quick'] #site-intro[data-design='arcade']     { --intro-total: 0.8s; }
  html[data-intro='quick'] #site-intro[data-design='terminal']   { --intro-total: 1.2s; }
  html[data-intro='quick'] #site-intro[data-design='tape']       { --intro-total: 1.4s; }
  html[data-intro='quick'] #site-intro[data-design='cartoon']    { --intro-total: 0.75s; }
  html[data-intro='quick'] #site-intro[data-design='clay']       { --intro-total: 0.7s; }

  /* Avant-garde: no title card, the stage just splits */
  html[data-intro='quick'] .intro-ag__stage { display: none; }
  html[data-intro='quick'] .intro-ag__panel { animation-delay: 0.18s; }

  /* Engineer: no hold on (END); the script pages back to page 1 in 0.3s */

  /* Terminal: the command is already typed; the session prints, then lifts at 0.45s,
