  /* A column like the hero's, so the margins between the login line and the prompt
     add up the same way. The script moves it onto the hero's own first lines. */
  .intro-ssh {
    position: absolute;
    top: 6.5rem;
    left: max(1.5rem, calc((100vw - 56rem) / 2 + 1.5rem));
    width: min(53rem, calc(100vw - 3rem));
