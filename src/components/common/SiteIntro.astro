  @keyframes ssh-off { to { visibility: hidden; } }
  /* "ssh ", a beat, then the address */
  @keyframes ssh-type {
    0% { width: 0; animation-timing-function: steps(4, end); }
    14% { width: 4ch; animation-timing-function: step-end; }
    32% { width: 4ch; animation-timing-function: steps(24, end); }
    100% { width: 28ch; }
  }

  /* ---------- Tape: the tape feeds in, the sheet is pulled off ---------- */
  .intro-tape__sheet {
