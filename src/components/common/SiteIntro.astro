---
// Intro curtain: one authored entrance per design world, played on every
// arrival at the site (hard loads only; ClientRouter navigations skip it).
// Gated by <html data-intro="wait|play">, set before paint in BaseLayout.
// Reduced-motion visitors never see it, and the page stays fully usable
// without JS because the curtain is display:none until the flag is set.
import TapeStrip from '@components/designs/tape/TapeStrip';
import Lettering from '@components/designs/cartoon/Lettering';
import T from '@components/ui/T.astro';
import { t } from '@i18n/utils';
import { RFC_FILE, rfcDate } from '@components/designs/engineer/rfc';
import { loginDate } from '@components/designs/terminal/session';
import { socialLinks } from '@data/social';

// Engineer: the draft's pages after the first, with what the pager's status line
// reads on each (the section on screen, how far through the file).
const draftPages = [
  { page: 2, n: '1.', k: 'rfc.intro', pct: '14%' },
  { page: 3, n: '2.', k: 'experience.title', pct: '29%' },
  { page: 4, n: '3.', k: 'education.title', pct: '43%' },
  { page: 5, n: '4.', k: 'skills.title', pct: '57%' },
  { page: 6, n: '5.', k: 'projects.title', pct: '71%' },
  { page: 7, n: '6.', k: 'rfc.address', pct: '86%' },
  { page: 8, n: '7.', k: 'rfc.references', pct: '' },
];
const draftDate = { en: rfcDate('en'), pt: rfcDate('pt') };
const login = { en: loginDate('en'), pt: loginDate('pt') };

// Tape: the hero's own tape (name, then role, in real ASCII), and its window's
// lines cut into one span per character so the reader can print them one by one.
// Hyphenated words stay unbroken, as KeepWords keeps them in the hero.
const punched = `${t('hero.name', 'en').toUpperCase()} . ${t('hero.title', 'en').toUpperCase()} . `;
const printable = (text: string) =>
  text.split(/(\S+-\S+)/).filter(Boolean).map((part) => ({ keep: part.includes('-'), chars: [...part] }));
---

<div id="site-intro" aria-hidden="true">
  <!-- Avant-garde: the name sharpens out of blur, a lime rule draws, the stage splits open -->
  <div class="intro intro-ag" data-design-show="avantgarde">
    <div class="intro-ag__panel intro-ag__panel--top"></div>
    <div class="intro-ag__panel intro-ag__panel--bottom"></div>
    <div class="intro-ag__stage">
      <p class="intro-ag__name">Alexandre Akira</p>
      <span class="intro-ag__rule"></span>
    </div>
  </div>

  <!-- Engineer: the draft opens at its end, (END) on page 8, then the pager pages
       back one whole screen at a time to page 1, where the hero prints. The script
       turns the pages; the status line is drawn as the page's pinned pager, so it
       stays put through the cut. -->
  <div class="intro intro-eng" data-design-show="engineer">
    <div class="intro-eng__reel">
      <div class="intro-eng__page"></div>
      {draftPages.map((p) => (
        <div class="intro-eng__page">
          <div class="rfc-col rfc-seam">
            <div class="rfc-seam__ln">
              <span><T k="rfc.draft" /></span><span><T k="hero.title" /></span><span><span data-lang-show="en">{draftDate.en}</span><span data-lang-show="pt">{draftDate.pt}</span></span>
            </div>
          </div>
          <div class="rfc-col intro-eng__body">
            <p class="rfc-h"><span class="rfc-n">{p.n}</span><T k={p.k} /></p>
            {p.page === 8 && (
              <dl class="rfc-refs">
                {socialLinks.map((link) => (
                  <>
                    <dt>[{link.name.toUpperCase().replace('.', '')}]</dt>
                    <dd><span class="intro-eng__a">{link.url.replace('mailto:', '')}</span></dd>
                  </>
                ))}
              </dl>
            )}
          </div>
          <div class="rfc-col rfc-seam intro-eng__foot">
            <div class="rfc-seam__ln">
              <span>Akira</span><span><T k="rfc.informational" /></span><span>[<T k="rfc.page" /> {p.page}]</span>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="rfc-pager">
      <span class="rfc-pager__file">{RFC_FILE}</span>
      <span class="rfc-pager__sec" data-eng-sec><span class="rfc-n">7.</span><T k="rfc.references" /></span>
      <span class="rfc-pager__pct" data-eng-pct data-end><T k="rfc.end" /></span>
    </div>
    <div hidden>
      <span data-eng-row><span><T k="rfc.abstract" /></span><span>0%</span></span>
      {draftPages.map((p) => (
        <span data-eng-row data-end={p.page === 8 ? '' : undefined}>
          <span><span class="rfc-n">{p.n}</span><T k={p.k} /></span>
          <span>{p.page === 8 ? <T k="rfc.end" /> : p.pct}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Creative: the halo finds its portrait. Rings ripple out to the hero's own
       halo geometry, the name rises beneath, then the halo glides to where the
       portrait lands while the paper dissolves. -->
  <div class="intro intro-cr" data-design-show="creative">
    <div class="intro-cr__paper">
      <p class="intro-cr__name"><span>Alexandre</span> <span class="intro-cr__last">Akira</span></p>
    </div>
    <div class="intro-cr__halo">
      <span class="intro-cr__glow"></span>
      <span class="intro-cr__disc"></span>
      <span class="intro-cr__ring intro-cr__ring--wave"></span>
      <span class="intro-cr__ring intro-cr__ring--outer"></span>
      <span class="intro-cr__ring intro-cr__ring--inner"></span>
    </div>
  </div>

  <!-- Editorial: an orange rule draws across newsprint beside the issue number, then the page turns -->
  <div class="intro intro-ed" data-design-show="editorial" data-intro-no-font-wait>
    <div class="intro-ed__page">
      <span class="intro-ed__issue">01</span>
      <span class="intro-ed__rule"></span>
    </div>
  </div>

  <!-- Terminal: the visitor's own plain shell connects over ssh. The remote session's
       first two lines land exactly on the hero's (the script lines them up), and the
       curtain lifts only once the hero has reset to that same frame (data-intro-hold),
       so the hero's replay carries straight on from the curtain. -->
  <div class="intro intro-term" data-design-show="terminal" data-intro-hold>
    <div class="term intro-ssh">
      <p class="intro-ssh__ln intro-ssh__cmd"><span class="intro-ssh__who">visitor@local </span>~ % <span class="intro-ssh__typed">ssh akira@alexandreakira.dev</span><span class="term-cursor intro-ssh__cur"></span></p>
      <p class="intro-ssh__ln intro-ssh__warn">Warning: Permanently added 'alexandreakira.dev' (ED25519) to the list of known hosts.</p>
      <p class="term-muted mb-5 intro-ssh__login">{(['en', 'pt'] as const).map((l) => <span data-lang-show={l}>{t('term.lastLogin', l)}: {login[l]} {t('term.on', l)} ttys001</span>)}</p>
      <p class="term-pl intro-ssh__prompt"><span class="term-u">akira@portfolio</span>:<span class="term-w">~</span>$ <span class="term-cursor"></span></p>
    </div>
  </div>

  <!-- Tape: the reader. The hero's own tape steps through one column at a time,
       blank leader first, and each column read prints its character in the hero's
       own window; the " . " between name and role is the line feed. Window and tape
       sit exactly on the hero's (the script places them), so when the page comes up
       around them (data-intro-hold="fade") nothing moves, and the hero's flag drops. -->
  <div class="intro intro-tape" data-design-show="tape" data-intro-hold="fade">
    <div class="tape tape-win intro-tape__win">
      <p class="m-0 font-heading text-[clamp(3rem,8vw,6rem)] font-black uppercase leading-[0.88]" data-tape-name>
        {[...t('hero.name', 'en')].map((c) => <span data-ch>{c}</span>)}
      </p>
      <p class="tape-caps mb-0 mt-3 text-[clamp(1.05rem,2.2vw,1.45rem)]">
        {(['en', 'pt'] as const).map((l) => (
          <span data-lang-show={l} data-tape-role={l}>
            {printable(t('hero.title', l)).map((part) =>
              part.keep ? (
                <span class="whitespace-nowrap">{part.chars.map((c) => <span data-ch>{c}</span>)}</span>
              ) : (
                part.chars.map((c) => <span data-ch>{c}</span>)
              ),
            )}
          </span>
        ))}
      </p>
    </div>
    <div class="tape-band intro-tape__band">
      <div class="intro-tape__feed"><TapeStrip columns={44} /><TapeStrip text={punched} columns={240} /></div>
    </div>
  </div>

  <!-- Cartoon: the titles open. "Alexandre Akira presents" is lettered on the black
       leader, cut, then an iris opens on Akira's face (the script finds it in the
       hero) onto the hero's own title card, whose entrance plays as it opens. -->
  <div class="intro intro-cart" data-design-show="cartoon">
    <div class="intro-cart__leader"></div>
    <p class="intro-cart__card">
      <span data-lang-show="en"><Lettering text={t('cartoon.presents', 'en')} /></span><span data-lang-show="pt"><Lettering text={t('cartoon.presents', 'pt')} /></span>
    </p>
  </div>

  <!-- Arcade: READY? pops and blinks, then five candy bars sweep the screen clean -->
  <div class="intro intro-arc" data-design-show="arcade">
    <div class="intro-arc__cabinet">
      <p class="intro-arc__ready">Ready?</p>
    </div>
    <div class="intro-arc__bars">
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
      <span class="intro-arc__bar"></span>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    var html = document.documentElement;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var active = null;

    // Engineer: put one page of the draft on screen, and the status line it reads.
    function draftPage(block, page) {
      var row = block.querySelectorAll('[data-eng-row]')[page - 1];
      var sec = block.querySelector('[data-eng-sec]');
      var pct = block.querySelector('[data-eng-pct]');
      if (!row || !sec || !pct) return;
      block.style.setProperty('--eng-page', String(page));
      sec.innerHTML = row.children[0].innerHTML;
      pct.innerHTML = row.children[1].innerHTML;
      if (row.hasAttribute('data-end')) pct.dataset.end = '';
      else delete pct.dataset.end;
    }

    // Terminal: set the remote session's first lines exactly on the hero's, so
    // lifting the curtain changes nothing on screen.
    function sshPlace(block) {
      var box = block.querySelector('.intro-ssh');
      var mine = block.querySelector('.intro-ssh__login');
      var hero = document.querySelector('#hero [data-design-show="terminal"] .term > .term-muted');
      if (!box || !mine || !hero) return;
      var r = hero.getBoundingClientRect();
      if (!r.width) return;
      box.style.left = r.left + 'px';
      box.style.width = r.width + 'px';
      box.style.top = Math.max(0, r.top - mine.offsetTop) + 'px';
    }

    // Where an element sits on screen without its own transform: the hero's
    // window is still at its entrance offset when it is measured under the curtain.
    function untransformed(el) {
      var r = el.getBoundingClientRect();
      var t = getComputedStyle(el).transform;
      var m = t && t !== 'none' ? new DOMMatrixReadOnly(t) : null;
      return { left: r.left - (m ? m.m41 : 0), top: r.top - (m ? m.m42 : 0), width: r.width };
    }

    // Tape: set the window and the tape on the hero's own.
    function tapePlace(block) {
      var hero = document.querySelector('#hero [data-design-show="tape"]');
      var win = block.querySelector('.intro-tape__win');
      var band = block.querySelector('.intro-tape__band');
      var heroWin = hero && hero.querySelector('.tape-win');
      var heroBand = hero && hero.querySelector('.tape-band');
      if (win && heroWin) {
        var w = untransformed(heroWin);
        win.style.left = w.left + 'px';
        win.style.top = w.top + 'px';
        win.style.width = w.width + 'px';
      }
      // On a short phone the hero's tape sits below the fold: read it on screen instead
      if (band && heroBand) band.style.top = Math.min(untransformed(heroBand).top, window.innerHeight - heroBand.offsetHeight - 24) + 'px';
      block.dataset.ready = '';
    }

    // The reader: 44 columns pass (the name, the " . " line feed, the role). The
    // tape moves in whole columns, as far as the screen shows well (all 44 on a
    // wide one), and ends where the hero's tape stands.
    var TAPE_NAME = 15, TAPE_FEED = 3, TAPE_COLS = 44;
    function tapeTravel() {
      return Math.max(8, Math.min(TAPE_COLS, Math.floor((window.innerWidth * 0.55) / 14)));
    }
    function tapeAt(block, col, travel) {
      var feed = block.querySelector('.intro-tape__feed');
      if (feed) feed.style.setProperty('--tape-at', String(TAPE_COLS - travel + Math.round((col * travel) / TAPE_COLS)));
    }
    function tapeRead(block, col, travel) {
      tapeAt(block, col + 1, travel);
      if (col < TAPE_NAME) {
        var ch = block.querySelectorAll('[data-tape-name] [data-ch]')[col];
        if (ch) ch.dataset.on = '';
      } else if (col >= TAPE_NAME + TAPE_FEED) {
        // The tape carries the English role; a role of another length prints in step with it
        var r = col - TAPE_NAME - TAPE_FEED + 1, of = TAPE_COLS - TAPE_NAME - TAPE_FEED;
        block.querySelectorAll('[data-tape-role]').forEach(function (role) {
          var chs = role.querySelectorAll('[data-ch]');
          for (var i = 0; i < Math.ceil((r * chs.length) / of); i++) chs[i].dataset.on = '';
        });
      }
    }

    // Cartoon: centre the iris on the face of the hero's painter. The drawing may
    // be mid-entrance (scaled), so it is read off its untransformed box: the face
    // sits 0.327 of the drawing's height right of its cell and 0.6455 above its foot.
    function cartPlace(block) {
      var cell = document.querySelector('#hero [data-design-show="cartoon"] [data-cartoon-painter]');
      var art = cell && cell.querySelector('.cartoon-painter__art');
      if (!art) return;
      var c = cell.getBoundingClientRect();
      var h = parseFloat(getComputedStyle(art).height);
      if (!c.width || !h) return;
      block.style.setProperty('--ix', Math.round(c.left + 0.327 * h) + 'px');
      block.style.setProperty('--iy', Math.round(c.bottom - 0.6455 * h) + 'px');
    }

    // Curtains staged by script as well as CSS. prepare() runs before the curtain
    // shows; start() when it begins to move: after the font wait on arrival, and
    // once the theme has swapped underneath on a quick change, so the incoming
    // hero is laid out and can be measured. A paced stage calls done() when its
    // sequence is over; otherwise a holding curtain is due at its reveal.
    var stages = {
      engineer: {
        prepare: function (block) { draftPage(block, 8); },
        start: function (block, mode, later) {
          var first = mode === 'arrival' ? 700 : 30;
          var every = mode === 'arrival' ? 85 : 50;
          for (var p = 7; p >= 1; p--) later(draftPage.bind(null, block, p), first + (7 - p) * every);
        }
      },
      terminal: {
        start: function (block) { sshPlace(block); }
      },
      cartoon: {
        start: function (block) { cartPlace(block); }
      },
      tape: {
        paced: true,
        prepare: function (block, mode) {
          delete block.dataset.ready;
          block.querySelectorAll('[data-ch]').forEach(function (ch) { delete ch.dataset.on; });
          // A quick change keeps the name printed and reads only the role
          if (mode === 'quick') block.querySelectorAll('[data-tape-name] [data-ch]').forEach(function (ch) { ch.dataset.on = ''; });
          tapeAt(block, mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0, tapeTravel());
        },
        start: function (block, mode, later, done) {
          var travel = tapeTravel();
          tapeAt(block, mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0, travel);
          tapePlace(block);
          var at = mode === 'arrival' ? 150 : 30;
          for (var col = mode === 'quick' ? TAPE_NAME + TAPE_FEED : 0; col < TAPE_COLS; col++) {
            later(tapeRead.bind(null, block, col, travel), at);
            at += mode === 'quick' ? 11 : col < TAPE_NAME ? 36 : col < TAPE_NAME + TAPE_FEED ? 40 : 16;
          }
          later(done, at + (mode === 'quick' ? 60 : 130));
        }
      }
    };

    // One curtain session. mode "arrival": the full intro armed by BaseLayout
    // (data-intro="wait"). mode "quick": a theme switch; the curtain wears the
    // incoming world, covers the page, the theme swaps underneath, then the
    // world's exit gesture reveals it.
    function run(mode, opts) {
      var el = document.getElementById('site-intro');
      if (!el) return null;
      var world = mode === 'arrival' ? html.dataset.design : opts.design;
      var block = el.querySelector('.intro[data-design-show="' + world + '"]');
      var stage = (block && stages[world]) || {};
      // A curtain that holds ends on the frame its hero starts from, so it lifts only
      // once that hero is in place underneath; --intro-total is the cap. It lifts
      // with a cut (Terminal), or with data-intro-hold="fade" by fading away while
      // the page comes up around what the two share (Tape).
      var hold = block ? block.getAttribute('data-intro-hold') : null;
      var holds = hold !== null;
      var s = { revealed: false, finished: false, applied: false, started: false, due: false, heroReady: false, timers: [] };
      active = s;

      function later(fn, ms) {
        s.timers.push(setTimeout(fn, ms));
      }
      function begin() {
        if (s.started || s.finished) return;
        s.started = true;
        if (stage.start) stage.start(block, mode, later, due);
      }
      function due() {
        s.due = true;
        lift();
      }
      // A hero hydrated earlier (a later switch back to its world) will not reset again
      function heroLive() {
        return !!document.querySelector('#hero [data-design-show="' + world + '"] astro-island:not([ssr])');
      }
      function lift() {
        if (!s.due || s.lifting || !(s.heroReady || heroLive())) return;
        if (hold !== 'fade' || !el.animate) { finish(); return; }
        s.lifting = el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: mode === 'quick' ? 280 : 350, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' });
        s.lifting.onfinish = finish;
      }
      function onHeroReady(e) {
        if (e.detail !== world) return;
        s.heroReady = true;
        lift();
      }
      function reveal() {
        if (s.revealed) return;
        s.revealed = true;
        if (html.dataset.intro === 'play') html.dataset.intro = 'reveal';
        document.dispatchEvent(new CustomEvent('site-intro:reveal'));
      }
      function applyTheme() {
        if (s.applied) return;
        s.applied = true;
        if (opts && opts.apply) opts.apply();
        if (mode === 'quick') begin();
      }
      function finish() {
        if (s.finished) return;
        s.finished = true;
        if (mode === 'arrival') reveal();
        applyTheme();
        html.dataset.intro = 'done';
        delete el.dataset.design;
        el.removeEventListener('animationend', onEnd);
        el.removeEventListener('click', finish);
        el.removeEventListener('wheel', finish);
        el.removeEventListener('touchmove', finish);
        document.removeEventListener('keydown', onKey);
        document.removeEventListener('site-hero:ready', onHeroReady);
        clearTimeout(s.timer);
        clearTimeout(s.applyTimer);
        s.timers.forEach(clearTimeout);
        if (s.lifting) s.lifting.cancel();
        active = null;
        document.dispatchEvent(new CustomEvent('site-intro:done'));
      }
      function onEnd(e) {
        if (e.target !== el) return;
        if (e.animationName === 'intro-reveal') {
          if (mode !== 'arrival') return;
          reveal();
          if (holds && !stage.paced) due();
        }
        else if (e.animationName === 'intro-root') finish();
      }
      function onKey(e) {
        if (e.key === 'Escape') finish();
      }
      function play() {
        if (html.dataset.intro !== 'wait') return;
        begin();
        html.dataset.intro = 'play';
      }

      if (stage.prepare) stage.prepare(block, mode);
      if (holds) document.addEventListener('site-hero:ready', onHeroReady);
      el.addEventListener('animationend', onEnd);
      el.addEventListener('click', finish);
      // A scroll gesture means "let me read": it ends the curtain instead of being swallowed.
      // (touchmove, not touchstart, so a tap cannot fall through onto a link underneath.)
      el.addEventListener('wheel', finish, { passive: true });
      el.addEventListener('touchmove', finish, { passive: true });
      document.addEventListener('keydown', onKey);
      s.timer = setTimeout(finish, mode === 'arrival' ? 4000 : 2000);

      if (mode === 'arrival' && el.querySelector('[data-design-show="' + html.dataset.design + '"][data-intro-no-font-wait]')) {
        // This world's curtain carries no type that needs its face: play at once.
        play();
      } else if (mode === 'arrival') {
        // Hold the curtain still until the world's display face is ready, so
        // the first frame is set in the right type. Never wait longer than 700ms.
        var fontsReady = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
        var fontTimer = setTimeout(play, 700);
        fontsReady.then(function () { clearTimeout(fontTimer); play(); }, play);
      } else {
        el.dataset.design = opts.design;
        html.dataset.intro = 'quick';
        s.applyTimer = setTimeout(applyTheme, 170);
        if (holds && !stage.paced) later(due, 450);
      }
      return s;
    }

    if (html.dataset.intro === 'wait') run('arrival');

    // Called by DesignToggle. Returns false when the caller should use its own
    // transition instead (reduced motion, a curtain already running, or an
    // unknown world).
    window.siteIntro = {
      quickChange: function (design, apply) {
        var el = document.getElementById('site-intro');
        if (reduce || active || !el || !el.querySelector('[data-design-show="' + design + '"]')) return false;
        return !!run('quick', { design: design, apply: apply });
      }
    };
  })();
</script>

<style is:global>
  /* ---------- Curtain root ---------- */
  #site-intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9990;
    overflow: hidden;
    cursor: default;
    animation:
      intro-reveal 1ms linear var(--intro-reveal, 1s) forwards,
      intro-root 1ms linear var(--intro-total, 1.6s) forwards;
  }
  html[data-intro='wait'] #site-intro,
  html[data-intro='play'] #site-intro,
  html[data-intro='reveal'] #site-intro {
    display: block;
  }
  html[data-intro='wait'] #site-intro,
  html[data-intro='wait'] #site-intro * {
    animation-play-state: paused;
  }
  @keyframes intro-reveal {
    to { outline-offset: 1px; }
  }
  @keyframes intro-root {
    to { visibility: hidden; }
  }

  .intro {
    position: absolute;
    inset: 0;
  }

  /* --intro-reveal: when the exit begins (heroes hydrate); --intro-total: when the curtain is gone */
  [data-design='avantgarde'] #site-intro { --intro-reveal: 1.05s; --intro-total: 1.75s; }
  [data-design='engineer']   #site-intro { --intro-reveal: 1.25s; --intro-total: 1.3s; }
  [data-design='creative']   #site-intro { --intro-reveal: 1.05s; --intro-total: 1.75s; }
  [data-design='editorial']  #site-intro { --intro-reveal: 0.95s; --intro-total: 1.65s; }
  [data-design='arcade']     #site-intro { --intro-reveal: 1.25s; --intro-total: 1.9s; }
  /* Terminal lifts as soon as its hero has reset under it (see data-intro-hold); 2.2s is the cap */
  [data-design='terminal']   #site-intro { --intro-reveal: 1.3s; --intro-total: 2.2s; }
  /* Tape hydrates its hero early (underneath, already in place) and fades when the reader is done; 2.6s cap */
  [data-design='tape']       #site-intro { --intro-reveal: 0.4s; --intro-total: 2.6s; }
  [data-design='cartoon']    #site-intro { --intro-reveal: 1s; --intro-total: 1.65s; }

  /* ---------- Quick-change (theme switch): the incoming world's exit gesture only ---------- */
  /* The curtain carries the incoming design on its own data-design so it can
     wear the new tokens and show the new world's block while <html> still
     holds the old design for the first 170ms. */
  #site-intro[data-design] [data-design-show] { display: none !important; }
  #site-intro[data-design='avantgarde'] [data-design-show='avantgarde'],
  #site-intro[data-design='engineer'] [data-design-show='engineer'],
  #site-intro[data-design='creative'] [data-design-show='creative'],
  #site-intro[data-design='editorial'] [data-design-show='editorial'],
  #site-intro[data-design='arcade'] [data-design-show='arcade'],
  #site-intro[data-design='terminal'] [data-design-show='terminal'],
  #site-intro[data-design='tape'] [data-design-show='tape'],
  #site-intro[data-design='cartoon'] [data-design-show='cartoon'] { display: block !important; }

  html[data-intro='quick'] #site-intro {
    display: block;
    --intro-reveal: 1ms;
    animation:
      intro-in 0.15s ease-out both,
      intro-reveal 1ms linear var(--intro-reveal) forwards,
      intro-root 1ms linear var(--intro-total) forwards;
  }
  @keyframes intro-in { from { opacity: 0; } }
  html[data-intro='quick'] #site-intro[data-design='avantgarde'] { --intro-total: 0.8s; }
  html[data-intro='quick'] #site-intro[data-design='engineer']   { --intro-total: 0.55s; }
  html[data-intro='quick'] #site-intro[data-design='creative']   { --intro-total: 0.75s; }
  html[data-intro='quick'] #site-intro[data-design='editorial']  { --intro-total: 0.75s; }
  html[data-intro='quick'] #site-intro[data-design='arcade']     { --intro-total: 0.8s; }
  html[data-intro='quick'] #site-intro[data-design='terminal']   { --intro-total: 1.2s; }
  html[data-intro='quick'] #site-intro[data-design='tape']       { --intro-total: 1.4s; }
  html[data-intro='quick'] #site-intro[data-design='cartoon']    { --intro-total: 0.75s; }

  /* Avant-garde: no title card, the stage just splits */
  html[data-intro='quick'] .intro-ag__stage { display: none; }
  html[data-intro='quick'] .intro-ag__panel { animation-delay: 0.18s; }

  /* Engineer: no hold on (END); the script pages back to page 1 in 0.3s */

  /* Terminal: the command is already typed; the session prints, then lifts at 0.45s,
     or once a hero switched on for the first time has reset under it (1.2s cap) */
  html[data-intro='quick'] .intro-ssh__typed { width: 28ch; animation: none; }
  html[data-intro='quick'] .intro-ssh .intro-ssh__cur { display: none; }
  html[data-intro='quick'] .intro-ssh__cmd { animation-delay: 0.2s; }
  html[data-intro='quick'] .intro-ssh__warn { animation-delay: 0.26s; }
  html[data-intro='quick'] .intro-ssh__login { animation-delay: 0.32s; }
  html[data-intro='quick'] .intro-ssh__prompt { animation-delay: 0.38s; }

  /* Tape: the name is already printed; the script reads the role in a burst, then the curtain fades */

  /* Cartoon: no title card; the iris opens on the incoming painter at once */
  html[data-intro='quick'] .intro-cart__card { display: none; }
  html[data-intro='quick'] .intro-cart__leader { animation-delay: 0.2s; animation-duration: 0.5s; }

  /* Creative: the halo is already whole, it glides to the portrait and dissolves */
  html[data-intro='quick'] .intro-cr__name,
  html[data-intro='quick'] .intro-cr__ring--wave { display: none; }
  html[data-intro='quick'] .intro-cr__glow,
  html[data-intro='quick'] .intro-cr__disc,
  html[data-intro='quick'] .intro-cr__ring--inner,
  html[data-intro='quick'] .intro-cr__ring--outer { opacity: 1; transform: none; animation: none; }
  html[data-intro='quick'] .intro-cr__halo {
    animation:
      cr-travel 0.5s cubic-bezier(0.83, 0, 0.17, 1) 0.15s forwards,
      cr-halo-out 0.25s ease-in 0.48s forwards;
  }
  html[data-intro='quick'] .intro-cr__paper { animation: cr-paper-out 0.35s ease-in 0.3s forwards; }

  /* Editorial: the printed sheet turns straight away */
  html[data-intro='quick'] .intro-ed__issue { opacity: 1; transform: translateY(-50%); animation: none; }
  html[data-intro='quick'] .intro-ed__rule { transform: scaleX(1); animation: none; }
  html[data-intro='quick'] .intro-ed__page { animation: ed-turn 0.55s cubic-bezier(0.83, 0, 0.17, 1) 0.18s forwards; }

  /* Arcade: the bars are already in, they sweep out */
  html[data-intro='quick'] .intro-arc__cabinet { display: none; }
  html[data-intro='quick'] .intro-arc__bar { transform: translateX(0); animation: arc-sweep-out 0.42s cubic-bezier(0.7, 0, 0.84, 0) forwards; }
  html[data-intro='quick'] .intro-arc__bar:nth-child(1) { animation-delay: 0.18s; }
  html[data-intro='quick'] .intro-arc__bar:nth-child(2) { animation-delay: 0.22s; }
  html[data-intro='quick'] .intro-arc__bar:nth-child(3) { animation-delay: 0.26s; }
  html[data-intro='quick'] .intro-arc__bar:nth-child(4) { animation-delay: 0.30s; }
  html[data-intro='quick'] .intro-arc__bar:nth-child(5) { animation-delay: 0.34s; }
  @keyframes arc-sweep-out { from { transform: translateX(0); } to { transform: translateX(101%); } }

  /* ---------- Avant-garde: sharpen, rule, split ---------- */
  .intro-ag__panel {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: var(--bg);
    animation-duration: 0.6s;
    animation-delay: 1.15s;
    animation-timing-function: cubic-bezier(0.83, 0, 0.17, 1);
    animation-fill-mode: forwards;
  }
  .intro-ag__panel--top { top: 0; animation-name: ag-split-top; }
  .intro-ag__panel--bottom { bottom: 0; animation-name: ag-split-bottom; }
  .intro-ag__stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    animation: ag-stage-out 0.25s ease-in 1.05s forwards;
  }
  .intro-ag__name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
    opacity: 0;
    filter: blur(14px);
    transform: translateY(8px);
    animation: ag-sharpen 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }
  .intro-ag__rule {
    display: block;
    width: min(60vw, 420px);
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    animation: ag-rule 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }
  @keyframes ag-sharpen {
    to { opacity: 1; filter: blur(0); transform: translateY(0); }
  }
  @keyframes ag-rule {
    to { transform: scaleX(1); }
  }
  @keyframes ag-stage-out {
    to { opacity: 0; }
  }
  @keyframes ag-split-top {
    to { transform: translateY(-101%); }
  }
  @keyframes ag-split-bottom {
    to { transform: translateY(101%); }
  }

  /* ---------- Engineer: the draft opens at (END), then pages back to page 1 ---------- */
  .intro-eng {
    background: var(--bg);
    color: var(--text);
  }
  /* One page per screen. The script sets --eng-page from 8 down to 1, so the reel
     moves in whole pages, the way a pager redraws, never in between. */
  .intro-eng__reel {
    position: absolute;
    inset: 0;
    transform: translateY(calc((1 - var(--eng-page, 8)) * 100%));
  }
  .intro-eng__page {
    position: relative;
    height: 100%;
    padding: 1.25rem 1.5rem 0;
  }
  .intro-eng__body {
    margin-top: 3.1em;
  }
  .intro-eng__body > .rfc-h {
    margin-top: 0;
  }
  /* The page's footer sits a line above the status line */
  .intro-eng__foot {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 3.25rem;
  }
  .intro-eng__a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }
  /* Nothing is set in a fallback face while the font wait holds the first frame */
  html[data-intro='wait'] .intro-eng__reel,
  html[data-intro='wait'] .intro-eng .rfc-pager {
    visibility: hidden;
  }

  /* ---------- Terminal: the visitor's shell connects over ssh ---------- */
  .intro-term {
    background: var(--bg);
  }
  /* A column like the hero's, so the margins between the login line and the prompt
     add up the same way. The script moves it onto the hero's own first lines. */
  .intro-ssh {
    position: absolute;
    top: 6.5rem;
    left: max(1.5rem, calc((100vw - 56rem) / 2 + 1.5rem));
    width: min(53rem, calc(100vw - 3rem));
    display: flex;
    flex-direction: column;
  }
  .intro-ssh__ln {
    margin: 0;
    color: var(--text-secondary);
  }
  .intro-ssh__cmd {
    white-space: nowrap;
  }
  /* The local shell has no theme: plain text, no colour */
  .intro-ssh__typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    width: 0;
    color: var(--text);
    animation: ssh-type 0.66s 0.28s forwards;
  }
  /* Steady while typing, gone at Enter */
  .intro-ssh .intro-ssh__cur {
    animation: ssh-off 1ms linear 0.98s forwards;
  }
  /* Each line prints whole, after the last */
  .intro-ssh > * {
    visibility: hidden;
    animation: ssh-on 1ms linear forwards;
  }
  .intro-ssh__cmd { animation-delay: 0.1s; }
  .intro-ssh__warn { animation-delay: 1.08s; }
  .intro-ssh__login { animation-delay: 1.2s; }
  .intro-ssh__prompt { animation-delay: 1.26s; }
  @media (max-width: 639px) {
    .intro-ssh__who { display: none; }
  }
  @keyframes ssh-on { to { visibility: visible; } }
  @keyframes ssh-off { to { visibility: hidden; } }
  /* "ssh ", a beat, then the address */
  @keyframes ssh-type {
    0% { width: 0; animation-timing-function: steps(4, end); }
    14% { width: 4ch; animation-timing-function: step-end; }
    32% { width: 4ch; animation-timing-function: steps(24, end); }
    100% { width: 28ch; }
  }

  /* ---------- Tape: the reader prints the name off the tape ---------- */
  .intro-tape {
    background: var(--bg);
  }
  /* Window and tape show once the script has set them on the hero's */
  .intro-tape .intro-tape__win,
  .intro-tape .intro-tape__band {
    position: absolute;
    visibility: hidden;
  }
  .intro-tape .intro-tape__win {
    top: 6rem;
    left: 1rem;
    width: min(40rem, calc(100vw - 2rem));
  }
  .intro-tape .intro-tape__band {
    left: 0;
    right: 0;
    top: 60%;
  }
  .intro-tape[data-ready] .intro-tape__win,
  .intro-tape[data-ready] .intro-tape__band {
    visibility: visible;
  }
  /* Blank leader, then the hero's punched tape, moved in whole columns (14px) */
  .intro-tape__feed {
    display: flex;
    flex: none;
    transform: translateX(calc(var(--tape-at, 0) * -14px));
  }
  .intro-tape__feed svg + svg {
    margin-left: 0;
  }
  /* A character prints when its column has been read */
  .intro-tape [data-ch] {
    visibility: hidden;
  }
  .intro-tape[data-ready] [data-ch][data-on] {
    visibility: visible;
  }

  /* ---------- Creative: the halo finds its portrait ---------- */
  /* Final ring geometry mirrors CreativeHero's portrait composition (320px box:
     blurred glow, gradient disc at 288px, rings at 256px and 192px). On md+ the
     halo travels to the portrait's position: right column centre of the 1152px
     hero grid, 64px down for the header offset. */
  .intro-cr__paper {
    position: absolute;
    inset: 0;
    background: var(--bg);
    animation: cr-paper-out 0.4s ease-in 1.25s forwards;
  }
  .intro-cr__halo {
    --halo-dx: 0px;
    --halo-dy: 0px;
    --halo-scale: 0.88; /* no portrait to land on below md: dissolve inward instead */
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320px;
    height: 320px;
    transform: translate(-50%, -50%);
    animation:
      cr-travel 0.6s cubic-bezier(0.83, 0, 0.17, 1) 1.05s forwards,
      cr-halo-out 0.25s ease-in 1.5s forwards;
  }
  @media (min-width: 768px) {
    .intro-cr__halo {
      --halo-dx: calc(24px + (min(1152px, 100vw - 48px) - 48px) / 4);
      --halo-dy: 64px;
      --halo-scale: 1;
    }
  }
  .intro-cr__glow,
  .intro-cr__disc,
  .intro-cr__ring {
    position: absolute;
    inset: 0;
    margin: auto;
    border-radius: 50%;
    opacity: 0;
  }
  .intro-cr__glow {
    width: 320px;
    height: 320px;
    background: linear-gradient(
      to bottom right,
      color-mix(in srgb, var(--accent) 30%, transparent),
      color-mix(in srgb, var(--accent) 10%, transparent)
    );
    filter: blur(64px);
    transform: scale(0.6);
    animation: cr-breathe 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0s forwards;
  }
  .intro-cr__disc {
    width: 288px;
    height: 288px;
    background: linear-gradient(to bottom right, color-mix(in srgb, var(--accent) 20%, transparent), transparent);
    transform: scale(0.5);
    animation: cr-breathe 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
  .intro-cr__ring { transform: scale(0.3); }
  .intro-cr__ring--inner {
    width: 192px;
    height: 192px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    animation: cr-ring 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }
  .intro-cr__ring--outer {
    width: 256px;
    height: 256px;
    border: 2px solid color-mix(in srgb, var(--accent) 20%, transparent);
    animation: cr-ring 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }
  .intro-cr__ring--wave {
    width: 320px;
    height: 320px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    animation: cr-wave 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }
  .intro-cr__name {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 190px);
    margin: 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--text);
    opacity: 0;
    transform: translateY(14px);
    filter: blur(6px);
    animation:
      cr-name-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards,
      cr-name-out 0.25s ease-in 1.05s forwards;
  }
  .intro-cr__last { color: var(--accent); }
  @keyframes cr-breathe { to { opacity: 1; transform: scale(1); } }
  @keyframes cr-ring { to { opacity: 1; transform: scale(1); } }
  @keyframes cr-wave {
    0%   { opacity: 0; transform: scale(0.3); }
    40%  { opacity: 1; }
    100% { opacity: 0; transform: scale(1.25); }
  }
  @keyframes cr-name-in { to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes cr-name-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes cr-paper-out { to { opacity: 0; } }
  @keyframes cr-travel {
    to { transform: translate(calc(-50% + var(--halo-dx)), calc(-50% + var(--halo-dy))) scale(var(--halo-scale)); }
  }
  @keyframes cr-halo-out { from { opacity: 1; } to { opacity: 0; } }

  /* ---------- Editorial: rule draws, page turns ---------- */
  .intro-ed__page {
    position: absolute;
    inset: 0;
    background: var(--bg);
    animation: ed-turn 0.6s cubic-bezier(0.83, 0, 0.17, 1) 1.05s forwards;
  }
  .intro-ed__issue {
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%) translateY(24px);
    font-family: var(--font-heading);
    font-size: clamp(10rem, 25vw, 18rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--text) 4%, transparent);
    opacity: 0;
    animation: ed-issue 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }
  @media (min-width: 768px) {
    .intro-ed__issue { right: 3rem; }
  }
  .intro-ed__rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    background: var(--accent);
    /* a stub of the rule is on the sheet from the first frame, then it draws across */
    transform: scaleX(0.06);
    transform-origin: left center;
    animation: ed-rule 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;
  }
  @keyframes ed-issue { to { opacity: 1; transform: translateY(-50%); } }
  @keyframes ed-rule { to { transform: scaleX(1); } }
  @keyframes ed-turn { to { transform: translateY(-101%); } }

  /* ---------- Cartoon: the credit on the leader, then the iris opens ---------- */
  @property --intro-iris {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  .intro-cart__leader {
    position: absolute;
    inset: 0;
    background: #121212;
    -webkit-mask: radial-gradient(circle at var(--ix, 50%) var(--iy, 42%), transparent var(--intro-iris), #000 calc(var(--intro-iris) + 0.5px));
    mask: radial-gradient(circle at var(--ix, 50%) var(--iy, 42%), transparent var(--intro-iris), #000 calc(var(--intro-iris) + 0.5px));
    animation: cart-iris 0.6s cubic-bezier(0.55, 0, 0.8, 0.35) 1s forwards;
  }
  .intro-cart__card {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 1.5rem;
    text-align: center;
    font: 900 clamp(2.4rem, 7vw, 5rem) / 0.95 'Londrina Solid', sans-serif;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fbfbfb;
    animation: cart-cut 1ms linear 0.95s forwards;
  }
  /* The credit's letters drop in on twos, as the hero's name will */
  .intro-cart__card .cl {
    animation: cartoon-drop 0.36s steps(1, end) both;
    animation-delay: calc(0.05s + var(--i) * 0.016s);
  }
  @keyframes cart-iris { to { --intro-iris: 150vmax; } }
  @keyframes cart-cut { to { visibility: hidden; } }

  /* ---------- Arcade: READY? then candy sweep ---------- */
  .intro-arc__cabinet {
    position: absolute;
    inset: 0;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: arc-cabinet-off 1ms linear 1.3s forwards;
  }
  .intro-arc__ready {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 9vw, 5.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0;
    transform: scale(0.6);
    animation:
      arc-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards,
      arc-blink 0.5s steps(1, end) 0.7s forwards;
  }
  .intro-arc__bars {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .intro-arc__bar {
    flex: 1;
    transform: translateX(-101%);
    animation: arc-sweep 0.9s linear forwards;
  }
  .intro-arc__bar:nth-child(1) { background: #0ba95b; animation-delay: 0.85s; }
  .intro-arc__bar:nth-child(2) { background: #12b5e5; animation-delay: 0.89s; }
  .intro-arc__bar:nth-child(3) { background: #f38ba3; animation-delay: 0.93s; }
  .intro-arc__bar:nth-child(4) { background: #a189cc; animation-delay: 0.97s; }
  .intro-arc__bar:nth-child(5) { background: #f55a6e; animation-delay: 1.01s; }
  @keyframes arc-pop { to { opacity: 1; transform: scale(1); } }
  @keyframes arc-blink {
    0%   { opacity: 1; }
    20%  { opacity: 0; }
    40%  { opacity: 1; }
    60%  { opacity: 0; }
    80%, 100% { opacity: 1; }
  }
  @keyframes arc-cabinet-off { to { opacity: 0; } }
  @keyframes arc-sweep {
    0%   { transform: translateX(-101%); animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
    33%  { transform: translateX(0); animation-timing-function: linear; }
    55%  { transform: translateX(0); animation-timing-function: cubic-bezier(0.7, 0, 0.84, 0); }
    100% { transform: translateX(101%); }
  }
</style>
