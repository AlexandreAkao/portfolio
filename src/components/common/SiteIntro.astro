  @keyframes cr-name-in { to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  @keyframes cr-name-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes cr-paper-out { to { opacity: 0; } }
  @keyframes cr-travel {
