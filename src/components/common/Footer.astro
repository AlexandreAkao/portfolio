---
import { t } from '@i18n/utils';
import T from '@components/ui/T.astro';
import { socialLinks } from '@data/social';
import { Icon } from 'astro-icon/components';
import DesignInvite from '@components/ui/DesignInvite.tsx';
import EngineerFooter from '@components/designs/engineer/EngineerFooter.astro';
import TerminalFooter from '@components/designs/terminal/TerminalFooter.astro';
import TapeFooter from '@components/designs/tape/TapeFooter.astro';
import CartoonFooter from '@components/designs/cartoon/CartoonFooter.astro';

const year = new Date().getFullYear();

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<footer>
  <div class="border-t border-border py-8" data-design-hide="editorial engineer terminal tape cartoon">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6">
      <div class="flex items-center gap-1 md:gap-6">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            {...(link.url.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
            class="inline-flex h-11 w-11 items-center justify-center text-text-secondary transition-colors hover:text-accent md:h-auto md:w-auto"
            aria-label={link.name}
          >
            {link.name === 'Dev.to' ? (
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6v4.36h.58c.37 0 .67-.07.84-.23.18-.17.25-.48.25-.93v-2.04c0-.45-.07-.76-.25-.93zm13.37-7.03H3.2C1.94 3.02 1 4.04 1 5.3v13.4c0 1.26.94 2.28 2.2 2.28h17.6c1.26 0 2.2-1.02 2.2-2.28V5.3c0-1.26-.94-2.28-2.2-2.28zM8.14 14.9c-.5.52-1.17.73-1.95.73H4.5V8.37h1.73c.78 0 1.44.22 1.95.74.48.49.71 1.19.71 2.06v1.7c0 .87-.23 1.56-.75 2.03zM12.56 9.8h-2.1v1.63h1.27v1.42h-1.27v1.73h2.1v1.42h-2.6c-.5 0-.91-.17-1.19-.5-.26-.31-.4-.72-.4-1.21V10c0-.49.14-.9.4-1.21.28-.33.69-.5 1.19-.5h2.6V9.8zm5.69 5.37c-.27.6-.74.9-1.38.9-.62 0-1.09-.27-1.38-.87-.22-.46-.33-1.14-.33-2.04v-.87c0-.9.11-1.57.33-2.02.29-.59.75-.87 1.37-.87.63 0 1.1.28 1.38.87.22.45.34 1.12.34 2.02v.87c0 .9-.12 1.58-.33 2.01z" /></svg>
            ) : (
              <Icon name={link.icon} class="h-5 w-5" />
            )}
          </a>
        ))}
      </div>
      <p class="text-xs text-text-secondary">
        <span data-lang-show="en">{t('footer.built', 'en')}</span>
        <span data-lang-show="pt">{t('footer.built', 'pt')}</span>
      </p>
      <p class="text-xs text-text-secondary">
        &copy; {year} Alexandre Akira
      </p>
    </div>
  </div>

  {/* Cartoon: THE END inside a closing iris */}
  <div data-design-show="cartoon">
    <CartoonFooter locale={locale} />
  </div>

  {/* Tape: the trailer runs out, END OF TAPE */}
  <div data-design-show="tape">
    <TapeFooter locale={locale} />
  </div>

  {/* Terminal: `exit`, logout, and the session closes */}
  <div data-design-show="terminal">
    <TerminalFooter locale={locale} />
  </div>

  {/* Engineer: the draft's References and Acknowledgements, then its last page footer */}
  <div data-design-show="engineer">
    <EngineerFooter locale={locale} />
  </div>

  {/* Editorial: the masthead's other end. Who, which edition, and the way into the other four designs. */}
  <div class="py-10" data-design-show="editorial">
    <div class="mx-auto grid max-w-6xl gap-8 border-t-[3px] border-accent px-6 pt-8 md:grid-cols-3">
      <div>
        <p class="font-heading text-2xl font-bold text-text">Alexandre Akira</p>
        <p class="text-sm text-text-secondary"><T k="hero.title" /></p>
      </div>
      <div class="space-y-1 text-sm text-text-secondary">
        <p><T k="footer.edition" /> {year} · &copy; Alexandre Akira</p>
        <p><T k="footer.built" /></p>
      </div>
      <div class="flex flex-col gap-4 md:items-end">
        <div class="flex items-center gap-1 md:gap-5">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              {...(link.url.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
              class="inline-flex h-11 w-11 items-center justify-center text-text-secondary transition-colors hover:text-accent md:h-auto md:w-auto"
              aria-label={link.name}
            >
              {link.name === 'Dev.to' ? (
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6v4.36h.58c.37 0 .67-.07.84-.23.18-.17.25-.48.25-.93v-2.04c0-.45-.07-.76-.25-.93zm13.37-7.03H3.2C1.94 3.02 1 4.04 1 5.3v13.4c0 1.26.94 2.28 2.2 2.28h17.6c1.26 0 2.2-1.02 2.2-2.28V5.3c0-1.26-.94-2.28-2.2-2.28zM8.14 14.9c-.5.52-1.17.73-1.95.73H4.5V8.37h1.73c.78 0 1.44.22 1.95.74.48.49.71 1.19.71 2.06v1.7c0 .87-.23 1.56-.75 2.03zM12.56 9.8h-2.1v1.63h1.27v1.42h-1.27v1.73h2.1v1.42h-2.6c-.5 0-.91-.17-1.19-.5-.26-.31-.4-.72-.4-1.21V10c0-.49.14-.9.4-1.21.28-.33.69-.5 1.19-.5h2.6V9.8zm5.69 5.37c-.27.6-.74.9-1.38.9-.62 0-1.09-.27-1.38-.87-.22-.46-.33-1.14-.33-2.04v-.87c0-.9.11-1.57.33-2.02.29-.59.75-.87 1.37-.87.63 0 1.1.28 1.38.87.22.45.34 1.12.34 2.02v.87c0 .9-.12 1.58-.33 2.01z" /></svg>
              ) : (
                <Icon name={link.icon} class="h-5 w-5" />
              )}
            </a>
          ))}
        </div>
        <DesignInvite client:visible world="editorial" locale={locale} />
      </div>
    </div>
  </div>
</footer>
