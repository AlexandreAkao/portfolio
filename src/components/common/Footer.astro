---
import { t } from '@i18n/utils';
import T from '@components/ui/T.astro';
import { socialLinks } from '@data/social';
import { Icon } from 'astro-icon/components';
import DesignInvite from '@components/ui/DesignInvite.tsx';

const year = new Date().getFullYear();

interface Props {
  /** The page's language, so the islands render in it on the server. */
  locale?: 'en' | 'pt';
}

const { locale } = Astro.props;
---

<footer>
  <div class="border-t border-border py-8" data-design-hide="editorial">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6">
      <div class="flex items-center gap-6">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            {...(link.url.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
            class="text-text-secondary transition-colors hover:text-accent"
            aria-label={link.name}
          >
            <Icon name={link.icon} class="h-5 w-5" />
          </a>
        ))}
      </div>
      <p class="text-xs text-text-secondary">
        <span data-lang-show="en">{t('footer.built', 'en')}</span>
        <span data-lang-show="pt">{t('footer.built', 'pt')}</span>
      </p>
      <p class="text-xs text-text-secondary">
        &copy; {year} Alexandre Akira
      </p>
    </div>
  </div>

  {/* Editorial: the masthead's other end. Who, which edition, and the way into the other four designs. */}
  <div class="py-10" data-design-show="editorial">
    <div class="mx-auto grid max-w-6xl gap-8 border-t-[3px] border-accent px-6 pt-8 md:grid-cols-3">
      <div>
        <p class="font-heading text-2xl font-bold text-text">Alexandre Akira</p>
        <p class="text-sm text-text-secondary"><T k="hero.title" /></p>
      </div>
      <div class="space-y-1 text-sm text-text-secondary">
        <p><T k="footer.edition" /> {year} · &copy; Alexandre Akira</p>
        <p><T k="footer.built" /></p>
      </div>
      <div class="flex flex-col gap-4 md:items-end">
        <div class="flex items-center gap-5">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              {...(link.url.startsWith('http') && { target: '_blank', rel: 'noopener noreferrer' })}
              class="text-text-secondary transition-colors hover:text-accent"
              aria-label={link.name}
            >
              <Icon name={link.icon} class="h-5 w-5" />
            </a>
          ))}
        </div>
        <DesignInvite client:visible world="editorial" locale={locale} />
      </div>
    </div>
  </div>
</footer>
